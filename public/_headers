# Cloudflare Pages headers — applied per-route in addition to defaults.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Hashed assets generated by Astro (filename includes content hash) — cache forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static images — long cache, allow revalidation
/images/*
  Cache-Control: public, max-age=2592000

# Favicons / manifest
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/site.webmanifest
  Cache-Control: public, max-age=604800

# HTML pages — short cache so content updates propagate fast.
# Astro serves pages as /about/index.html at URL /about, so a
# `/*.html` match on the request path never fires. Use `/*` and rely on
# the more-specific `/_astro/*` and `/images/*` rules above to override.
/*
  Cache-Control: public, max-age=300, must-revalidate

# Security headers (apply to everything)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
  # HSTS — 1 year, includeSubDomains. NOT submitting to Chrome preload list
  # (preload registration is effectively irreversible).
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # CSP — self + GA4 + Paddle + Lemon Squeezy + Turnstile.
  # LS is the active Merchant of Record; Paddle sandbox stays until KYC lands.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://cdn.paddle.com https://sandbox-cdn.paddle.com https://challenges.cloudflare.com https://assets.lemonsqueezy.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://assets.lemonsqueezy.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.paddle.com https://challenges.cloudflare.com https://*.lemonsqueezy.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://*.paddle.com https://challenges.cloudflare.com https://*.lemonsqueezy.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://*.lemonsqueezy.com https://*.paddle.com; object-src 'none'
