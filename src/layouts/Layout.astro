---
import '../styles/global.css';
import { SITE, LOCALES } from '../config/site.js';
import { t } from '../i18n/translations.js';

type Lang = 'uk' | 'ru' | 'pl' | 'en' | 'es' | 'de' | 'fr' | 'it' | 'pt';

interface Props {
  /** Page title (server-rendered per language; no client mutation). */
  title?: string;
  /** Meta description. */
  description?: string;
  /** Page language (uk | ru | pl | en). */
  lang?: Lang;
  /** URL path RELATIVE to the site root. Examples:
   *  ''         → /            (uk home)
   *  'ru'       → /ru/         (ru home)
   *  'privacy'  → /privacy     (uk privacy)
   *  'ru/privacy' → /ru/privacy (ru privacy)
   */
  path?: string;
  /** Page type — drives JSON-LD and GA loading. */
  pageType?: 'home' | 'legal' | 'error' | 'about' | 'content';
  /** When true, add <meta name="robots" content="noindex,nofollow"> (use for 404). */
  noindex?: boolean;
  /** Override GA loading. Default rule: load only on home. Set true to also load on /thank-you so purchase events fire. */
  loadGA?: boolean;
  /** Restrict hreflang alternates to the languages this page actually has
   *  (e.g. a blog post in ru+uk only). Defaults to all supported languages
   *  (see SITE.supportedLangs — currently uk/ru/pl/en/es/de/fr/it/pt). */
  hreflangLangs?: Array<'uk' | 'ru' | 'pl' | 'en' | 'es' | 'de' | 'fr' | 'it' | 'pt'>;
  /** Per-page OG/Twitter image (absolute URL or root-relative). Falls back
   *  to SITE.ogImage. Used by blog posts and recipe pages for better social CTR. */
  ogImage?: string;
  /** Extra JSON-LD blocks (Recipe, Article, ItemList, etc.) rendered after the
   *  standard Organization / WebSite / Breadcrumb graph. Pass an object or array. */
  jsonLd?: object | object[];
  /** Intermediate breadcrumb between Home and the current page — turns the
   *  default 2-level trail into 3 levels. Example on a recipe page:
   *  { name: 'Рецепти', url: '/recipes/' } → Home / Recipes / Cake. */
  breadcrumb?: { name: string; url: string };
  /** Article metadata — when set, emits og:type=article + article:published_time
   *  / article:modified_time / article:author for better share previews and
   *  Google News eligibility on blog posts. */
  articleMeta?: { publishedAt?: string; updatedAt?: string; author?: string };
}

const {
  title       = 'Bento Cake by TROUBLEBABA — 10 рецептів бенто-тортів | PDF',
  description = 'Збірник 10 авторських рецептів бенто-тортів від кондитера @troublebaba. PDF з покроковими фото, точними грамажами та таблицею перерахунку.',
  lang        = SITE.defaultLang as Lang,
  path        = '',
  pageType    = 'home',
  noindex     = false,
  loadGA: loadGAOverride,
  hreflangLangs,
  ogImage,
  jsonLd,
  breadcrumb,
  articleMeta,
} = Astro.props;

const BASE     = import.meta.env.BASE_URL;
const SITE_URL = SITE.url;

// Helpers ---------------------------------------------------------------
const SUPPORTED: Lang[] = SITE.supportedLangs as Lang[];

// Build absolute URL: home for lang, with trailing slash. UK home is at root.
function homePathFor(l: Lang): string {
  return l === 'uk' ? '/' : `/${l}/`;
}

// Strip the lang prefix from `path` if it leads. Returns subpath: '' | 'privacy' | 'terms'.
function stripLangPrefix(p: string): string {
  const parts = p.replace(/^\/+/, '').replace(/\/+$/, '').split('/');
  if (parts.length === 0) return '';
  const head = parts[0];
  if ((SUPPORTED as string[]).includes(head)) return parts.slice(1).join('/');
  return parts.join('/');
}

// Localized URL for the SAME logical page in a different language.
function altUrlFor(l: Lang): string {
  const sub = stripLangPrefix(path);
  return SITE_URL + homePathFor(l) + sub;
}

const CANONICAL = SITE_URL + (path
  ? '/' + path.replace(/^\/+/, '').replace(/\/+$/, '') + (pageType === 'home' ? '/' : '')
  : '/');

// Per-page OG image override — accept absolute URL or root-relative path.
const OG_IMAGE  = ogImage
  ? (/^https?:\/\//.test(ogImage) ? ogImage : SITE_URL + (ogImage.startsWith('/') ? ogImage : '/' + ogImage))
  : SITE_URL + SITE.ogImage;
const extraJsonLd: object[] = jsonLd
  ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd])
  : [];
const OG_LOCALE = LOCALES[lang]?.og || 'uk_UA';

// Localized og:image:alt — same PDF cover, described in the reader's language
// so FB/Twitter/LinkedIn screenreaders and previews are on-locale.
const OG_IMAGE_ALT_BY_LANG: Record<Lang, string> = {
  uk: 'Bento Cake — PDF збірник рецептів від TROUBLEBABA',
  ru: 'Bento Cake — PDF-сборник рецептов от TROUBLEBABA',
  pl: 'Bento Cake — PDF ze zbiorem przepisów od TROUBLEBABA',
  en: 'Bento Cake — PDF recipe collection by TROUBLEBABA',
  es: 'Bento Cake — colección de recetas en PDF de TROUBLEBABA',
  de: 'Bento Cake — PDF-Rezeptsammlung von TROUBLEBABA',
  fr: 'Bento Cake — recueil de recettes PDF par TROUBLEBABA',
  it: 'Bento Cake — raccolta di ricette in PDF di TROUBLEBABA',
  pt: 'Bento Cake — coleção de receitas em PDF da TROUBLEBABA',
};
const OG_IMAGE_ALT = OG_IMAGE_ALT_BY_LANG[lang] || OG_IMAGE_ALT_BY_LANG.uk;

// Localized product:price:amount + currency — matches the LS store for that
// language so social/shopping crawlers don't advertise $20 on a /pl/ page
// showing 80 zł. Keep values in sync with SITE.checkout.buyUrls.
// Таблица цен переехала в src/config/site.js: она нужна ещё двум шаблонам
// страниц вкусов, а три копии со временем разъехались бы.
const PRICE_BY_LANG = SITE.pricesByLang as Record<Lang, { amount: string; currency: string }>;
const priceMeta = PRICE_BY_LANG[lang] || PRICE_BY_LANG.uk;

// Hreflang alternates — emit for home and legal pages (skip 404/error).
const emitHreflang = pageType === 'home' || pageType === 'legal' || pageType === 'about' || pageType === 'content';
// `hreflangLangs` lets a page restrict alternates to the languages it ACTUALLY
// has (e.g. a blog post that exists only in ru+uk). Defaults to all supported.
// Pointing hreflang at non-existent (404) versions is a real SEO error.
const altLangs = (hreflangLangs && hreflangLangs.length ? hreflangLangs : SUPPORTED) as Lang[];
const hreflangEntries = altLangs.map(l => ({ lang: l, url: altUrlFor(l) }));
// x-default — версия «для всех остальных», кого не поймал ни один hreflang.
// Раньше указывал на украинскую: логично для СНГ, но посетитель из Бразилии
// или Италии по умолчанию попадал на украиноязычную страницу. Английская —
// нейтральный выбор для международного трафика, а uk/ru/pl продолжают
// приходить по своим hreflang как раньше.
const xDefaultUrl = altUrlFor(altLangs.includes('en') ? 'en' : altLangs[0]);

// JSON-LD helpers -------------------------------------------------------
const tr = (t as Record<string, any>)[lang] || (t as Record<string, any>).uk;

// Localized breadcrumb "Home" label per language.
const HOME_LABEL: Record<Lang, string> = {
  uk: 'Головна',
  ru: 'Главная',
  pl: 'Strona główna',
  en: 'Home',
  es: 'Inicio',
  de: 'Startseite',
  fr: 'Accueil',
  it: 'Home',
  pt: 'Início',
};
const homeLabel = HOME_LABEL[lang] ?? 'Home';

// Localized Product.category per language.
const PRODUCT_CATEGORY: Record<Lang, string> = {
  uk: 'Цифрова збірка рецептів',
  ru: 'Цифровой сборник рецептов',
  pl: 'Cyfrowy zbiór przepisów',
  en: 'Digital cookbook',
  es: 'Recetario digital',
  de: 'Digitales Kochbuch',
  fr: 'Livre de recettes numérique',
  it: 'Ricettario digitale',
  pt: 'Livro de receitas digital',
};

// Customer reviews — count per language, used for the visible badge in the
// reviews section. NOT fed into structured data: see the note at the Product
// schema below for why AggregateRating was removed.
const REVIEW_FILES = import.meta.glob('../data/reviews/*.json', { eager: true }) as Record<string, { default: { text: string; name?: string; rating?: number }[] }>;
const reviewCount = (
  REVIEW_FILES[`../data/reviews/${lang}.json`]?.default
  ?? REVIEW_FILES['../data/reviews/en.json']?.default
  ?? REVIEW_FILES['../data/reviews/ru.json']?.default
  ?? []
).length;

// Средний рейтинг для AggregateRating — считается из оценок в отзывах.
// Если ни одного `rating` нет, схема рейтинга не выводится вовсе:
// заявлять рейтинг без собранных оценок нельзя ни по правилам Google
// Structured Data, ни по Omnibus Directive в ЕС.
const _reviewList = (
  REVIEW_FILES[`../data/reviews/${lang}.json`]?.default
  ?? REVIEW_FILES['../data/reviews/en.json']?.default
  ?? REVIEW_FILES['../data/reviews/ru.json']?.default
  ?? []
);
const _scored = _reviewList.filter(r => typeof r.rating === 'number' && r.rating >= 1 && r.rating <= 5);
// Приоритет — среднее из реальных оценок. Пока их нет, используется
// заявленное владельцем значение из SITE.reviews.averageRating.
const _computed = _scored.length
  ? Math.round((_scored.reduce((a, r) => a + (r.rating as number), 0) / _scored.length) * 10) / 10
  : null;
const ratingValue = _computed ?? ((SITE as any).reviews?.averageRating ?? null);
const ratingCount = _computed !== null ? _scored.length : _reviewList.length;

// Load GA4 on every real page (home, content, about, legal) so organic
// landing pages (recipes, blog posts) actually count. Explicit `loadGA` prop
// still wins (e.g. force-off on some page); 404s stay untracked because
// pageType='error' is filtered here.
const loadGA = (loadGAOverride ?? (pageType !== 'error')) && !!SITE.gaId;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <base href={BASE} />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <meta name="author" content={SITE.name} />
  <meta name="theme-color" content={SITE.themeColor} />
  <!-- Pinterest domain verification (claim) -->
  <meta name="p:domain_verify" content="69f3bb56cc3d7584a7d85ade4c8e523f" />

  <!-- Yandex Webmaster verification — RU/UA-аудитория, 4 169 показов в месяц -->
  <meta name="yandex-verification" content="73eb61215f84cdb8" />
  <meta name="color-scheme" content="light" />

  <!-- Canonical (per-page) -->
  <link rel="canonical" href={CANONICAL} />

  {emitHreflang && (
    <>
      <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
      {hreflangEntries.map(e => (
        <link rel="alternate" hreflang={e.lang} href={e.url} />
      ))}
    </>
  )}

  <!-- Open Graph (Facebook, Telegram, WhatsApp, LinkedIn) -->
  <meta property="og:type"             content={articleMeta ? 'article' : pageType === 'home' ? 'product' : 'website'} />
  {articleMeta && articleMeta.publishedAt && (
    <meta property="article:published_time" content={articleMeta.publishedAt} />
  )}
  {articleMeta && articleMeta.updatedAt && (
    <meta property="article:modified_time" content={articleMeta.updatedAt} />
  )}
  {articleMeta && articleMeta.author && (
    <meta property="article:author" content={articleMeta.author} />
  )}
  <meta property="og:site_name"        content={SITE.name} />
  <meta property="og:title"            content={title} />
  <meta property="og:description"      content={description} />
  <meta property="og:url"              content={CANONICAL} />
  <meta property="og:image"            content={OG_IMAGE} />
  <meta property="og:image:secure_url" content={OG_IMAGE} />
  <meta property="og:image:type"       content={SITE.ogImageType} />
  <meta property="og:image:width"      content={String(SITE.ogImageWidth)} />
  <meta property="og:image:height"     content={String(SITE.ogImageHeight)} />
  <meta property="og:image:alt"        content={OG_IMAGE_ALT} />
  <meta property="og:locale"           content={OG_LOCALE} />
  {SUPPORTED.filter(l => l !== lang).map(l => (
    <meta property="og:locale:alternate" content={LOCALES[l].og} />
  ))}

  <!-- Product price meta — picked up by Pinterest, some Telegram clients -->
  {pageType === 'home' && (
    <>
      <meta property="product:price:amount"   content={priceMeta.amount} />
      <meta property="product:price:currency" content={priceMeta.currency} />
    </>
  )}

  <!-- Twitter / X Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:site"        content="@troublebaba" />
  <meta name="twitter:creator"     content="@troublebaba" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={OG_IMAGE} />
  <meta name="twitter:image:alt"   content="Bento Cake — PDF збірник рецептів від TROUBLEBABA" />

  <!-- Favicon set -->
  <link rel="icon"             type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon"             type="image/x-icon"  href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180"      href="/apple-touch-icon.png" />
  <link rel="manifest"         href="/site.webmanifest" />
  <link rel="mask-icon"        href="/favicon.svg" color="#8B7355" />

  <!-- Google Analytics 4 — loaded on every real page.
       `lang` and `page_type` go out with every event so we can slice
       conversions by locale (uk / ru / pl / en / …) and by section
       (home / content / about / legal) inside GA4. -->
  {loadGA && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`} is:inline></script>
      <script is:inline define:vars={{ gaId: SITE.gaId, pageLang: lang, pageKind: pageType }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('set', 'user_properties', { lang: pageLang });
        gtag('config', gaId, {
          anonymize_ip: true,
          page_lang: pageLang,
          page_kind: pageKind,
        });
      </script>
    </>
  )}

  <!-- Fonts — the three families actually rendered on the page:
       Playfair Display (headlines, .font-cabinet), Manrope (body, .font-outfit),
       Caveat (two handwritten signatures). @fontsource/outfit was removed —
       it shipped 72 KB of webfont that rendered on zero elements because every
       declaration listed Manrope first.
       Loaded non-blocking: the stylesheet is fetched as `print` (which the
       parser does not block on), then flipped to `all` on load. The <noscript>
       keeps it working without JS. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800;900&family=Manrope:wght@400;500;600;700&family=Caveat:wght@600&display=swap"
    media="print"
    onload="this.media='all';this.onload=null;"
  />
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800;900&family=Manrope:wght@400;500;600;700&family=Caveat:wght@600&display=swap" rel="stylesheet" />
  </noscript>

  <!-- JSON-LD: Organization (always) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": SITE.name,
    "url": SITE_URL + '/',
    "logo": SITE_URL + '/favicon.svg',
    "sameAs": [SITE.instagramUrl, SITE.tiktokUrl, SITE.youtubeUrl, SITE.facebookUrl],
    "email": SITE.contactEmail,
  })} />

  <!-- JSON-LD: WebSite (always) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": SITE.productName,
    "url": SITE_URL + '/',
    "inLanguage": SITE.supportedLangs,
  })} />

  {pageType === 'home' && tr?.faq_items && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "inLanguage": lang,
      "mainEntity": tr.faq_items.map((it: any) => ({
        "@type": "Question",
        "name": it.q,
        "acceptedAnswer": { "@type": "Answer", "text": it.a },
      })),
    })} />
  )}

  {pageType === 'home' && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      "name": SITE.productName,
      "description": description,
      "inLanguage": lang,
      "brand": { "@type": "Brand", "name": SITE.name },
      "image": OG_IMAGE,
      "category": PRODUCT_CATEGORY[lang] || PRODUCT_CATEGORY.en,
      "sku": "troublebaba-bento-cake-pdf",
      // AggregateRating выводится ТОЛЬКО если у отзывов есть числовые оценки:
      // ratingValue вычисляется как среднее (см. выше), reviewCount — это
      // количество оценённых отзывов, а не всех подряд. До 7 сентября 2026
      // здесь стояла захардкоженная «4.9» без собранных оценок, что нарушало
      // Structured Data guidelines Google.
      ...(ratingValue !== null ? {
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": String(ratingValue),
          "reviewCount": String(ratingCount),
          "bestRating": "5",
          "worstRating": "1",
        }
      } : {}),
      "offers": {
        "@type": "Offer",
        "price": priceMeta.amount,
        "priceCurrency": priceMeta.currency,
        "availability": "https://schema.org/InStock",
        "itemCondition": "https://schema.org/NewCondition",
        // Offer.url должен вести на страницу, где товар покупается.
        // Раньше здесь стоял SITE.paymentUrl — ссылка на несуществующий
        // Gumroad, то есть разметка Product уводила Google в никуда.
        "url": CANONICAL,
        "seller": { "@type": "Organization", "name": SITE.name },
      }
    })} />
  )}

  {pageType === 'home' && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": homeLabel, "item": CANONICAL },
      ],
    })} />
  )}

  {(pageType === 'legal' || pageType === 'about' || pageType === 'content') && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumb ? [
        { "@type": "ListItem", "position": 1, "name": homeLabel, "item": SITE_URL + homePathFor(lang) },
        { "@type": "ListItem", "position": 2, "name": breadcrumb.name,
          "item": /^https?:\/\//.test(breadcrumb.url) ? breadcrumb.url : SITE_URL + (breadcrumb.url.startsWith('/') ? breadcrumb.url : '/' + breadcrumb.url) },
        { "@type": "ListItem", "position": 3, "name": title.split(' | ')[0], "item": CANONICAL },
      ] : [
        { "@type": "ListItem", "position": 1, "name": homeLabel, "item": SITE_URL + homePathFor(lang) },
        { "@type": "ListItem", "position": 2, "name": title.split(' | ')[0], "item": CANONICAL },
      ],
    })} />
  )}

  {pageType === 'about' && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "TROUBLEBABA",
      "alternateName": "Zhenya",
      "jobTitle": "Pastry chef",
      "url": CANONICAL,
      "image": SITE_URL + '/images/author.webp',
      "sameAs": [SITE.instagramUrl, SITE.tiktokUrl, SITE.youtubeUrl, SITE.facebookUrl],
      "worksFor": { "@type": "Organization", "name": SITE.name, "url": SITE_URL + '/' },
    })} />
  )}

  {extraJsonLd.map(block => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))}
</head>
<body>
  <slot />
</body>
</html>
