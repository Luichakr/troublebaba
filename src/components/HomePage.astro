---
import { Icon } from 'astro-icon/components';
import SectionEyebrow from './SectionEyebrow.astro';
import { t } from '../i18n/translations.js';
import { SITE, BONUS_TOTAL } from '../config/site.js';
import SiteFooter from './SiteFooter.astro';

type Lang = 'uk' | 'ru' | 'pl' | 'en';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = t[lang] as Record<string, any>;

// Helpers
const isUk = lang === 'uk';
// Preserve the current path when switching language. E.g. on
// /ru/recipes/red-velvet-bento-cake/ switching to en → /en/recipes/red-velvet-bento-cake/.
// Falls back to home when no path is available.
const SUPPORTED = new Set(['uk','ru','pl','en','es','de','fr','it','pt']);
const rawPath   = (Astro.url && Astro.url.pathname) || '/';
const _parts    = rawPath.replace(/^\/+/, '').replace(/\/+$/, '').split('/');
const _headIsLang = _parts.length > 0 && SUPPORTED.has(_parts[0]);
const subPath   = _headIsLang ? _parts.slice(1).join('/') : _parts.join('/');
const langUrl  = (l) => {
  const base = l === 'uk' ? '/' : `/${l}/`;
  return subPath ? base + subPath + '/' : base;
};
const blogHref = isUk ? '/blog/' : `/${lang}/blog/`;
const anchor = (id: string) => (isUk ? '/' : `/${lang}/`) + '#' + id;

// Pre-launch mode: buy buttons collect e-mails instead of opening checkout.
const presale = SITE.presaleMode === true;
const turnstileKey = SITE.turnstile?.siteKey || '';
const communityBonus = SITE.community?.enabled === true;

const RECIPE_IMAGES = [
  'images/q9.webp',   // 0: Oreo
  'images/q10.webp',  // 1: Red Velvet
  'images/q3.webp',   // 2: Poppy-Citrus
  'images/q8.webp',   // 3: Snickers
  'images/q1.webp',   // 4: Raffaello
  'images/q5.webp',   // 5: Ferrero Rocher
  'images/q6.webp',   // 6: Cinnabon
  'images/q2.webp',   // 7: Pistachio-Raspberry
  'images/q7.webp',   // 8: Pina Colada
  'images/q4.webp',   // 9: Cherry Chocolate
];

// Адаптивные варианты для карточек рецептов. Файлы лежат в public/, поэтому
// Astro их не обрабатывает — варианты 480/768/1024 генерирует
// `npm run img:responsive` (scripts/build-responsive-images.mjs).
// Без этого телефон тянул оригинал 1122×1122 (~420 КБ) на карточку 327 px.
const recipeSrcSet = (src: string) => {
  const stem = src.replace(/\.webp$/, '');
  return [480, 768, 1024].map(w => `/${stem}-${w}.webp ${w}w`).join(', ') + `, /${src} 1122w`;
};
const RECIPE_SIZES = '(max-width: 767px) 92vw, (max-width: 1279px) 45vw, 30vw';

// Same order as RECIPE_IMAGES — each card links to /recipes/<slug>/.
const RECIPE_SLUGS = [
  'oreo-bento-cake',
  'red-velvet-bento-cake',
  'poppy-seed-citrus-bento-cake',
  'snickers-bento-cake',
  'raffaello-bento-cake',
  'ferrero-rocher-bento-cake',
  'cinnabon-bento-cake',
  'pistachio-raspberry-bento-cake',
  'pina-colada-bento-cake',
  'cherry-chocolate-bento-cake',
];
const recipeHref = (idx: number) => (isUk ? '' : '/' + lang) + '/recipes/' + RECIPE_SLUGS[idx] + '/';

// "Useful before you buy" hub: links the money page to the 5 commercial-intent
// blog posts (size / cost / shelf life / cream choice / cream fixes). Passes
// homepage authority deeper into the site and answers pre-purchase questions.
// Titles come from the content collection, so every locale gets its own copy.
import { getCollection } from 'astro:content';
const HUB_SLUGS = ['bento-cake-size', 'bento-cake-cost', 'bento-cake-shelf-life', 'which-cream-for-bento', 'cream-not-holding-shape'];
const _hubPool = await getCollection('blog', (e: any) => e.data.draft === false && e.data.lang === lang);
const hubPosts = HUB_SLUGS
  .map(s => _hubPool.find((p: any) => p.data.slug === s))
  .filter(Boolean)
  .map((p: any) => ({
    slug: p.data.slug,
    title: p.data.title,
    excerpt: p.data.excerpt ?? p.data.description,
    cover: p.data.cover || '/images/cta-book.webp',
  }));
const hubLead = hubPosts[0];
const hubRest = hubPosts.slice(1, 5);

const LANGS: { c: Lang; l: string; full: string }[] = [
  { c: 'uk', l: 'UKR', full: 'Українська' },
  { c: 'ru', l: 'RUS', full: 'Русский' },
  { c: 'pl', l: 'POL', full: 'Polski' },
  { c: 'en', l: 'ENG', full: 'English' },
  { c: 'es', l: 'ESP', full: 'Español' },
  { c: 'de', l: 'DEU', full: 'Deutsch' },
  { c: 'fr', l: 'FRA', full: 'Français' },
  { c: 'it', l: 'ITA', full: 'Italiano' },
  { c: 'pt', l: 'POR', full: 'Português' },
];
const currentLangLabel = LANGS.find(x => x.c === lang)?.l ?? 'UKR';

// Soft guarantee / reassurance — honest support promise (not money-back), 9 langs, EN fallback.
const GUAR: Record<string, { title: string; text: string }> = {
  uk: { title: 'Купуй спокійно', text: 'Не вийшло з першого разу? Напиши на pr.troublebaba@gmail.com — розберемо разом, крок за кроком, поки не вийде.' },
  ru: { title: 'Покупай спокойно', text: 'Не получилось с первого раза? Напиши на pr.troublebaba@gmail.com — разберём вместе, шаг за шагом, пока не получится.' },
  pl: { title: 'Kupuj spokojnie', text: 'Nie wyszło za pierwszym razem? Napisz na @troublebaba — przejdziemy przez to razem, krok po kroku.' },
  en: { title: 'Buy with confidence', text: 'Didn’t work the first time? Message @troublebaba — we’ll walk through it together, step by step.' },
  es: { title: 'Compra con confianza', text: '¿No salió a la primera? Escríbenos a @troublebaba y lo resolvemos juntos, paso a paso.' },
  de: { title: 'Kauf mit Vertrauen', text: 'Beim ersten Mal nicht geklappt? Schreib an @troublebaba — wir gehen es gemeinsam durch, Schritt für Schritt.' },
  fr: { title: 'Achetez en confiance', text: 'Ça n’a pas marché du premier coup ? Écris à @troublebaba — on résout ça ensemble, étape par étape.' },
  it: { title: 'Acquista con serenità', text: 'Non è venuto al primo tentativo? Scrivici su @troublebaba — lo risolviamo insieme, passo dopo passo.' },
  pt: { title: 'Compre com confiança', text: 'Não deu certo de primeira? Escreve para @troublebaba — resolvemos juntos, passo a passo.' },
};
const guar = GUAR[lang] ?? GUAR.en;

// PDF preview — four STRUCTURAL pages: cover, the author's welcome, and the
// section title pages ("choosing your products", "frosting creams"). They show
// how the book is built and how it looks, which the flavour grid above cannot.
// An earlier version used the 10 recipe title pages and simply repeated that
// grid — same names, same layer lists, no new information.
// The pages that carry the actual know-how (product brands, equipment list,
// diameter conversion table, assembly method) stay out: they'd be usable
// straight off a screenshot. Locales without their own PDF fall back to EN.
const PREVIEW_PAGES: Record<string, number[]> = {
  uk: [1, 2, 3, 62],
  ru: [1, 2, 3, 62],
  pl: [1, 2, 3, 62],
  en: [1, 2, 3, 55],
};
const previewLang = PREVIEW_PAGES[lang] ? lang : 'en';
const previewPages = PREVIEW_PAGES[previewLang];

// Customer reviews — one JSON file per language in src/data/reviews/.
// Falls back to EN, then RU, if a locale file is missing at build time.
const REVIEW_FILES = import.meta.glob<{ default: { text: string; name?: string; rating?: number }[] }>(
  '../data/reviews/*.json',
  { eager: true },
);
const reviewsFor = (l: string): { text: string; name?: string; rating?: number }[] =>
  REVIEW_FILES[`../data/reviews/${l}.json`]?.default ?? [];
// Средний рейтинг — ВЫЧИСЛЯЕТСЯ из оценок в самих отзывах, не проставляется
// руками. Если ни у одного отзыва нет поля `rating`, блок звёзд и разметка
// AggregateRating не выводятся вообще: рейтинг без собранных оценок — это
// нарушение Structured Data guidelines Google и потенциальная проблема
// с законом о защите потребителей (Omnibus Directive в ЕС).
// Чтобы звёзды появились, достаточно добавить "rating": 5 в записи
// src/data/reviews/<lang>.json — среднее пересчитается само.
function averageRating(list: { rating?: number }[]): number | null {
  const scored = list.filter(r => typeof r.rating === 'number' && r.rating >= 1 && r.rating <= 5);
  if (!scored.length) return null;
  const sum = scored.reduce((a, r) => a + (r.rating as number), 0);
  return Math.round((sum / scored.length) * 10) / 10;
}

// Подпись под рейтингом: «на основі 51 відгуку». Отдельно от pluralReviews,
// потому что там счётчик стоит вместо рейтинга и формулировка другая.
function ratingBasis(n: number, l: string): string {
  const slavic = (one: string, few: string, many: string) => {
    const m10 = n % 10, m100 = n % 100;
    if (m10 === 1 && m100 !== 11) return one;
    if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return few;
    return many;
  };
  switch (l) {
    case 'uk': return slavic(`на основі\n${n} відгуку`, `на основі\n${n} відгуків`, `на основі\n${n} відгуків`);
    case 'ru': return slavic(`на основе\n${n} отзыва`, `на основе\n${n} отзывов`, `на основе\n${n} отзывов`);
    case 'pl': return slavic(`na podstawie\n${n} opinii`, `na podstawie\n${n} opinii`, `na podstawie\n${n} opinii`);
    case 'de': return `basierend auf\n${n} Bewertungen`;
    case 'fr': return `sur la base de\n${n} avis`;
    case 'it': return `basato su\n${n} recensioni`;
    case 'es': return `basado en\n${n} opiniones`;
    case 'pt': return `com base em\n${n} avaliações`;
    default:   return `based on\n${n} reviews`;
  }
}

// Плюрализация счётчика отзывов. «51 відгуків» — неграмотно: при числах,
// що закінчуються на 1 (крім 11), потрібна однина. Те саме російською
// та польською, у кожної мови свої правила.
function pluralReviews(n: number, l: string): string {
  const slavic = (one: string, few: string, many: string) => {
    const m10 = n % 10, m100 = n % 100;
    if (m10 === 1 && m100 !== 11) return one;
    if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return few;
    return many;
  };
  switch (l) {
    case 'uk': return slavic('відгук покупців', 'відгуки покупців', 'відгуків покупців');
    case 'ru': return slavic('отзыв покупателей', 'отзыва покупателей', 'отзывов покупателей');
    case 'pl': return slavic('opinia kupujących', 'opinie kupujących', 'opinii kupujących');
    case 'de': return n === 1 ? 'Kundenbewertung' : 'Kundenbewertungen';
    case 'fr': return n === 1 ? 'avis client' : 'avis clients';
    case 'it': return n === 1 ? 'recensione dei clienti' : 'recensioni dei clienti';
    case 'es': return n === 1 ? 'opinión de clientes' : 'opiniones de clientes';
    case 'pt': return n === 1 ? 'avaliação de clientes' : 'avaliações de clientes';
    default:   return n === 1 ? 'customer review' : 'customer reviews';
  }
}

const reviews = (
  reviewsFor(lang).length ? reviewsFor(lang)
  : reviewsFor('en').length ? reviewsFor('en')
  : reviewsFor('ru')
);
// Рейтинг: сначала пробуем посчитать из оценок в самих отзывах (поле
// `rating`). Если их ещё нет — берём заявленное владельцем значение из
// SITE.reviews.averageRating (см. комментарий там о том, откуда цифра и
// по каким правилам её менять). Как только у отзывов появятся оценки,
// вычисленное значение автоматически перебьёт заявленное.
const computedRating = averageRating(reviews);
const ratingValue = computedRating ?? (SITE.reviews?.averageRating ?? null);
const ratedCount = computedRating !== null
  ? reviews.filter(r => typeof r.rating === 'number').length
  : reviews.length;
const REVIEWS_INITIAL = 9; // shown before "show more"
---

  <!-- ── HEADER ── -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-cream/95 backdrop-blur-md border-b border-taupe/15">
    <div class="max-w-[1440px] mx-auto px-4 lg:px-16 h-[68px] lg:h-[72px] flex items-center justify-between gap-2 lg:gap-6">
      <a href={langUrl(lang)} class="min-h-[44px] font-cabinet text-espresso flex-shrink-0 text-[1.1rem] lg:text-[1.55rem]" style="letter-spacing:0.01em;">TROUBLEBABA</a>
      <nav class="hidden md:flex items-center gap-10 font-outfit text-[13px] font-semibold tracking-[0.16em] uppercase text-espresso/65">
        <a href={anchor('recipes')} class="hover:text-espresso transition-colors">{tr.nav_recipes}</a>
        <a href={anchor('about')} class="hover:text-espresso transition-colors">{tr.nav_author}</a>
        <a href={blogHref} class="hover:text-espresso transition-colors">{tr.nav_blog}</a>
        <a href={anchor('price')} class="hover:text-espresso transition-colors">{tr.nav_price}</a>
        <a href={anchor('faq')} class="hover:text-espresso transition-colors">FAQ</a>
      </nav>
      <div class="flex items-center gap-3 flex-shrink-0">
        <!-- Language dropdown -->
        <div class="relative hidden sm:block" id="lang-dropdown-wrap">
          <button id="lang-dropdown-btn" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="lang-menu" aria-label="Choose language" class="flex items-center gap-1.5 font-outfit font-semibold text-[13px] tracking-[0.12em] uppercase text-espresso/70 hover:text-espresso transition-colors px-4 py-2.5 rounded-full border border-taupe/40 hover:border-taupe/60">
            <span id="lang-label">{currentLangLabel}</span>
            <Icon name="ph:caret-down" class="transition-transform duration-200 w-[11px] h-[7px]" />
          </button>
          <div id="lang-menu" role="listbox" aria-label="Languages" class="hidden absolute right-0 top-full mt-2 bg-warm-white border border-taupe/25 rounded-2xl shadow-xl overflow-hidden min-w-[150px] z-50" style="box-shadow:0 12px 40px rgba(139,115,85,0.18);">
            {LANGS.map(x => (
              <a href={langUrl(x.c)} role="option" aria-label={x.full} aria-current={x.c === lang ? 'page' : undefined} class={`lang-btn w-full flex items-center justify-between px-4 py-3 font-outfit text-sm transition-colors ${x.c === lang ? 'bg-surface text-espresso' : 'text-espresso/70 hover:bg-surface hover:text-espresso'}`}>
                <span class="font-medium">{x.full}</span>
                <span class="text-xs text-espresso/65 font-outfit tracking-wider uppercase">{x.l}</span>
              </a>
            ))}
          </div>
        </div>
        <!-- CTA -->
        <a href={isUk ? "/#price" : "/" + lang + "/#price"} data-checkout-trigger="1" data-buy-source="header"
           class="min-h-[44px] flex items-center gap-1.5 bg-mocha-dark text-warm-white font-outfit font-semibold text-[11.5px] lg:text-[13px] px-3 lg:px-5 py-2 lg:py-2.5 rounded-full hover:bg-mocha-dark transition-colors whitespace-nowrap">
          {tr.nav_buy}
        </a>
        <!-- Mobile burger menu -->
        <button id="mobile-menu-btn" type="button" aria-controls="mobile-menu" aria-expanded="false" class="md:hidden w-11 h-11 rounded-full flex items-center justify-center text-espresso hover:bg-taupe/15 transition-colors flex-shrink-0" aria-label="Menu">
          <Icon name="ph:list" class="w-[18px] h-[13px]" />
        </button>
      </div>
    </div>

    <!-- Mobile menu dropdown -->
    <div id="mobile-menu" role="menu" aria-label="Main menu" class="hidden md:hidden absolute top-full left-0 right-0 bg-warm-white border-b border-taupe/20" style="box-shadow:0 12px 32px rgba(139,115,85,0.15);">
      <div class="px-6 py-4 flex flex-col gap-1">
        <a href={anchor('recipes')} class="font-outfit font-semibold text-[13px] tracking-[0.14em] uppercase text-espresso/70 hover:text-espresso py-3 border-b border-taupe/10 transition-colors mobile-menu-link">{tr.nav_recipes}</a>
        <a href={anchor('about')} class="font-outfit font-semibold text-[13px] tracking-[0.14em] uppercase text-espresso/70 hover:text-espresso py-3 border-b border-taupe/10 transition-colors mobile-menu-link">{tr.nav_author}</a>
        <a href={blogHref} class="font-outfit font-semibold text-[13px] tracking-[0.14em] uppercase text-espresso/70 hover:text-espresso py-3 border-b border-taupe/10 transition-colors mobile-menu-link">{tr.nav_blog}</a>
        <a href={anchor('price')} class="font-outfit font-semibold text-[13px] tracking-[0.14em] uppercase text-espresso/70 hover:text-espresso py-3 border-b border-taupe/10 transition-colors mobile-menu-link">{tr.nav_price}</a>
        <a href={anchor('faq')} class="font-outfit font-semibold text-[13px] tracking-[0.14em] uppercase text-espresso/70 hover:text-espresso py-3 border-b border-taupe/10 last:border-b-0 transition-colors mobile-menu-link">FAQ</a>
        <!-- Language switcher in mobile menu -->
        <div class="pt-3 mt-2 flex gap-2">
          {LANGS.map(x => (
            <a href={langUrl(x.c)} aria-current={x.c === lang ? 'page' : undefined} class={`lang-btn flex-1 text-center font-outfit font-semibold text-[11px] tracking-[0.12em] uppercase transition-colors py-2 rounded-full border ${x.c === lang ? 'bg-surface text-espresso border-taupe/60' : 'text-espresso/65 hover:text-espresso border-taupe/30'}`}>{x.l}</a>
          ))}
        </div>
      </div>
    </div>
  </header>

  <!-- ── HERO ── -->
  <!-- Sizes to content (no forced 85vh) so a shorter viewport — e.g. with the
       browser bookmarks bar visible — never crowds the eyebrow under the fixed
       header. pt clears the 68px header; generous lg padding gives breathing
       room top and bottom. -->
  <section class="pt-[80px] lg:pt-[92px] pb-12 lg:pb-16">
    <div class="max-w-[1440px] mx-auto lg:px-16 flex flex-col-reverse lg:flex-row lg:items-center gap-8 lg:gap-12">

    <!-- Left: text -->
    <div class="flex-1 flex flex-col justify-center px-6 lg:px-0 lg:pr-4 py-8 lg:py-0 w-full lg:max-w-[520px]">

      <!-- Eyebrow + heart (desktop only — on mobile shown over photo) -->
      <div class="animate-fade-up mb-7 hidden lg:block">
        <div class="flex items-center gap-3 mb-3">
          <p class="font-outfit text-[11px] font-semibold tracking-[0.18em] uppercase text-espresso/65">
            {tr.hero_by}
          </p>
        </div>
        <div class="flex items-center gap-2">
          <div class="h-px w-10 bg-mocha/40"></div>
          <svg width="12" height="11" viewBox="0 0 13 12" fill="none">
            <path d="M6.5 11C6.5 11 1 7.3 1 3.8C1 2.3 2.2 1 3.8 1C4.8 1 5.7 1.5 6.2 2.3C6.3 2.5 6.7 2.5 6.8 2.3C7.3 1.5 8.2 1 9.2 1C10.8 1 12 2.3 12 3.8C12 7.3 6.5 11 6.5 11Z" stroke="#8B7355" stroke-width="1.4" stroke-linejoin="round" fill="none"/>
          </svg>
          <div class="h-px w-10 bg-mocha/40"></div>
        </div>
      </div>

      <!-- Main heading. On desktop it's the visible wordmark; on mobile we
           keep the same <h1> in the DOM but visually hide it (sr-only) so
           Google, screen readers and Search Console still see the page's
           actual heading. The decorative "BENTO CAKE" over the mobile hero
           photo further down is <div aria-hidden> — style only, no <h1>
           duplication. Do NOT switch this back to `hidden lg:block` — that
           is display:none and drops the H1 from mobile-first indexing. -->
      <h1 class="animate-fade-up animate-fade-up-d1 font-cabinet text-espresso leading-[0.9] mb-5 sr-only lg:not-sr-only lg:block" style="font-size:var(--h-hero);">
        <span class="block">BENTO</span><span class="block">CAKE</span>
        {tr.hero_h1_kw && (
          <span style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;border:0;">{tr.hero_h1_kw}</span>
        )}
      </h1>

      <!-- Sub (desktop only — on mobile shown over photo) -->
      <p class="animate-fade-up animate-fade-up-d2 font-outfit text-espresso/65 leading-relaxed mb-6 max-w-[440px] hidden lg:block" style="font-size:clamp(0.95rem,1.2vw,1.05rem);">
        {tr.hero_sub}
      </p>

      <!-- Feature chips — DESIGN.md §5.2/§7: single flex-wrap row, left-aligned,
           content-sized, identical padding + radius + shadow on every chip.
           Ordered longest-first so natural wrap reads cleanly. -->
      <div class="animate-fade-up animate-fade-up-d2 flex flex-wrap justify-start gap-2.5 mb-6 lg:mb-7">
        <div class="inline-flex items-center gap-2 bg-warm-white border border-taupe/30 rounded-xl px-3.5 py-2.5 shadow-sm">
          <Icon name="ph:book-open" class="flex-shrink-0 w-[16px] h-[16px]" />
          <span class="font-outfit text-[13px] lg:text-sm font-medium text-espresso/75 leading-none whitespace-nowrap">{tr.hero_chip1}</span>
        </div>
        <div class="inline-flex items-center gap-2 bg-warm-white border border-taupe/30 rounded-xl px-3.5 py-2.5 shadow-sm">
          <Icon name="ph:fork-knife" class="flex-shrink-0 w-[16px] h-[16px]" />
          <span class="font-outfit text-[13px] lg:text-sm font-medium text-espresso/75 leading-none whitespace-nowrap">{tr.hero_chip5}</span>
        </div>
        <div class="inline-flex items-center gap-2 bg-warm-white border border-taupe/30 rounded-xl px-3.5 py-2.5 shadow-sm">
          <Icon name="ph:list-checks" class="flex-shrink-0 w-[16px] h-[16px]" />
          <span class="font-outfit text-[13px] lg:text-sm font-medium text-espresso/75 leading-none whitespace-nowrap">{tr.hero_chip4}</span>
        </div>
        <div class="inline-flex items-center gap-2 bg-warm-white border border-taupe/30 rounded-xl px-3.5 py-2.5 shadow-sm">
          <Icon name="ph:image" class="flex-shrink-0 w-[16px] h-[16px]" />
