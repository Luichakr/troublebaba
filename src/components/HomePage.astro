                <div>
                  <div class="font-outfit font-semibold text-warm-white/85 text-[13px] leading-snug">{tr.cta_trust2_title || tr.price_once?.replace(/^\/\s*/,'') || ''}</div>
                  <div class="font-outfit text-warm-white/55 text-[11px] leading-snug mt-0.5">{tr.cta_trust2_sub || ''}</div>
                </div>
              </div>
              <div class="flex items-start gap-2.5">
                <div class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.10);">
                  <Icon name="ph:shield-check" class="w-[14px] h-[14px]" />
                </div>
                <div>
                  <div class="font-outfit font-semibold text-warm-white/85 text-[13px] leading-snug">{tr.cta_trust3_title || tr.price_secure}</div>
                  <div class="font-outfit text-warm-white/55 text-[11px] leading-snug mt-0.5">{tr.cta_trust3_sub || ''}</div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── FOOTER ── -->
  <SiteFooter lang={lang} />

  <!-- ── Mobile sticky CTA ── -->
  <a id="sticky-cta" href={isUk ? "/#price" : "/" + lang + "/#price"} data-checkout-trigger="1" data-buy-source="sticky-mobile"
     class="md:hidden fixed bottom-4 left-4 right-4 z-40 bg-mocha-dark text-warm-white font-outfit font-bold text-[15px] flex items-center justify-center gap-2 py-4 rounded-2xl shadow-2xl opacity-0 pointer-events-none translate-y-4 transition-all duration-300"
     style="box-shadow:0 8px 28px rgba(139,115,85,0.45);">
    {tr.nav_buy}
  </a>

<!-- PDF-language modal shown after a Buy click, before the LS redirect. -->
<div id="pdf-lang-modal" role="dialog" aria-modal="true" aria-labelledby="pdf-lang-title"
     class="fixed inset-0 z-[60] hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4">
  <div class="w-full max-w-sm bg-cream rounded-3xl shadow-2xl p-6 relative">
    <button type="button" id="pdf-lang-close" aria-label="Close"
            class="absolute top-3 right-3 w-9 h-9 rounded-full flex items-center justify-center text-espresso/65 hover:text-espresso hover:bg-espresso/5 transition">
      <Icon name="ph:x" class="w-[18px] h-[18px]" />
    </button>
    <h3 id="pdf-lang-title" class="font-cabinet font-bold text-[22px] text-espresso leading-tight pr-6">{tr.pdf_lang_title}</h3>
    <p class="mt-1 text-[13px] text-espresso/65">{tr.pdf_lang_hint}</p>
    <div class="mt-5 grid grid-cols-2 gap-2.5">
      <button type="button" data-pdf-lang="uk" class="pdf-lang-opt py-3 rounded-xl border border-espresso/15 bg-warm-white hover:bg-mocha-dark hover:text-warm-white hover:border-mocha transition font-outfit font-semibold text-[15px] text-espresso">Українська</button>
      <button type="button" data-pdf-lang="ru" class="pdf-lang-opt py-3 rounded-xl border border-espresso/15 bg-warm-white hover:bg-mocha-dark hover:text-warm-white hover:border-mocha transition font-outfit font-semibold text-[15px] text-espresso">Русский</button>
      <button type="button" data-pdf-lang="en" class="pdf-lang-opt py-3 rounded-xl border border-espresso/15 bg-warm-white hover:bg-mocha-dark hover:text-warm-white hover:border-mocha transition font-outfit font-semibold text-[15px] text-espresso">English</button>
      <button type="button" data-pdf-lang="pl" class="pdf-lang-opt py-3 rounded-xl border border-espresso/15 bg-warm-white hover:bg-mocha-dark hover:text-warm-white hover:border-mocha transition font-outfit font-semibold text-[15px] text-espresso">Polski</button>
    </div>
  </div>
</div>

<!-- Expose translated buy-button states + presale flag + LS checkout to the bundled script. -->
<script is:inline define:vars={{ buyLoading: tr.buy_loading, buyError: tr.buy_error, presale, notifySuccess: tr.notify_success, notifyError: tr.notify_error, pageLang: lang, turnstileKey, lsCheckoutUrl: SITE.lemonsqueezy?.enabled ? SITE.lemonsqueezy.checkoutUrl : '', lsCheckoutByLang: SITE.lemonsqueezy?.enabled ? (SITE.lemonsqueezy.checkoutByLang || {}) : {} }}>
  window.TR_BUY_LOADING     = buyLoading;
  window.TR_BUY_ERROR       = buyError;
  window.TR_PRESALE         = presale;
  window.TR_NOTIFY_OK       = notifySuccess;
  window.TR_NOTIFY_ERR      = notifyError;
  window.TR_PAGE_LANG       = pageLang;
  window.TR_TURNSTILE       = turnstileKey;
  window.TR_LS_CHECKOUT     = lsCheckoutUrl;
  window.TR_LS_BY_LANG      = lsCheckoutByLang;
</script>
{turnstileKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>}

<script>
import { BONUS_TOTAL, BONUS_REMAINING } from '../i18n/translations.js';

// Reviews: reveal the rest on "show all", then remove the button.
(function initReviewsMore() {
  const btn = document.getElementById('reviews-more-btn');
  if (!btn) return;
  btn.addEventListener('click', () => {
    document.querySelectorAll<HTMLElement>('#reviews-grid .review-card[hidden]')
      .forEach(el => { el.hidden = false; });
    btn.remove();
  });
})();

function attachFaqListeners() {
  const toggle = (item: Element) => {
    const wasOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(i => {
      i.classList.remove('open');
      i.setAttribute('aria-expanded', 'false');
    });
    if (!wasOpen) {
      item.classList.add('open');
      item.setAttribute('aria-expanded', 'true');
    }
  };
  document.querySelectorAll('.faq-item').forEach(item => {
    item.addEventListener('click', () => toggle(item));
    item.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      if (key === 'Enter' || key === ' ') {
        e.preventDefault();
        toggle(item);
      }
    });
  });
}

// Scroll reveal
const observer = new IntersectionObserver(entries => {
  entries.forEach(el => {
    if (el.isIntersecting) {
      el.target.classList.add('visible');
      observer.unobserve(el.target);
    }
  });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

// FAQ accordion
attachFaqListeners();

// ── Bonus counter: LIVE. Reads /api/bonus/count, animates TOTAL → remaining ──
(() => {
  const counterEl = document.getElementById('bonus-counter');
  if (!counterEl) return;

  const numEl     = document.getElementById('bonus-counter-num');
  const barEl     = document.getElementById('bonus-counter-bar') as HTMLElement | null;
  const takenEl   = document.getElementById('bonus-counter-taken');
  const soldBadge = document.getElementById('bonus-soldout-badge');
  const ctaBtn    = document.getElementById('bonus-cta-btn') as HTMLElement | null;

  // Initial paint — everything full, animation waits for the API + viewport.
  if (numEl) numEl.textContent = String(BONUS_TOTAL);
  if (takenEl) takenEl.textContent = '0';
  if (barEl) barEl.style.transform = 'scaleX(1)';

  let live = { total: BONUS_TOTAL, remaining: BONUS_TOTAL };
  fetch('/api/bonus/count')
    .then(r => r.ok ? r.json() : null)
    .then(d => { if (d && typeof d.total === 'number' && typeof d.remaining === 'number') live = d; })
    .catch(() => { /* fall back to defaults above */ });

  const animate = () => {
    const target   = Math.max(0, live.remaining);
    const total    = Math.max(1, live.total);
    if (target <= 0) {
      counterEl.style.opacity = '0.6';
      counterEl.style.filter  = 'grayscale(0.4)';
      if (soldBadge) soldBadge.classList.remove('hidden');
      if (ctaBtn) {
        ctaBtn.style.opacity = '0.55';
        ctaBtn.style.pointerEvents = 'none';
        ctaBtn.classList.remove('btn-pulse');
      }
    }
    const duration = 1800;
    const startTime = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - startTime) / duration);
      const eased = 1 - Math.pow(1 - p, 3);
      const cur = Math.round(total - (total - target) * eased);
      const takenCur = total - cur;
      if (numEl) numEl.textContent = String(cur);
      if (takenEl) takenEl.textContent = String(takenCur);
      if (barEl) barEl.style.transform = 'scaleX(' + (cur / total) + ')';
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };

  const bonusObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        // Give the fetch a tick to settle if it's already in-flight.
        setTimeout(animate, 150);
        bonusObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.3 });
  bonusObs.observe(counterEl);
})();

// Sticky CTA — show after scroll past hero on mobile
const stickyCta = document.getElementById('sticky-cta');
if (stickyCta) {
  const showAfter = window.innerHeight * 0.8;
  const onScroll = () => {
    if (window.scrollY > showAfter) {
      stickyCta.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
    } else {
      stickyCta.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
}

// Mobile menu toggle
const mobMenuBtn = document.getElementById('mobile-menu-btn');
const mobMenu = document.getElementById('mobile-menu');
const setMobOpen = (open: boolean) => {
  mobMenu?.classList.toggle('hidden', !open);
  mobMenuBtn?.setAttribute('aria-expanded', String(open));
};
if (mobMenuBtn && mobMenu) {
  mobMenuBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    setMobOpen(mobMenu.classList.contains('hidden'));
  });
  document.querySelectorAll('.mobile-menu-link').forEach(link => {
    link.addEventListener('click', () => setMobOpen(false));
  });
  document.addEventListener('click', (e) => {
    if (!mobMenu.contains(e.target as Node) && !mobMenuBtn.contains(e.target as Node)) {
      setMobOpen(false);
    }
  });
}

// Lang dropdown toggle (items are now anchor links)
const dropBtn = document.getElementById('lang-dropdown-btn');
const dropMenu = document.getElementById('lang-menu');
const dropChevron = document.getElementById('lang-chevron');
const setDropOpen = (open: boolean) => {
  dropMenu?.classList.toggle('hidden', !open);
  dropBtn?.setAttribute('aria-expanded', String(open));
  dropChevron?.style.setProperty('transform', open ? 'rotate(180deg)' : '');
};
if (dropBtn && dropMenu) {
  dropBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    setDropOpen(dropMenu.classList.contains('hidden'));
  });
  document.addEventListener('click', () => setDropOpen(false));
}

// ESC closes mobile menu and lang dropdown
document.addEventListener('keydown', (e) => {
  if (e.key !== 'Escape') return;
  setMobOpen(false);
  setDropOpen(false);
});

// ── Events: GA4 + own /api/track (D1) ──
type GtagFn = (event: 'event', name: string, params?: Record<string, unknown>) => void;
const gtag = (window as unknown as { gtag?: GtagFn }).gtag;

/** Fire-and-forget tracker. Mirrors event into GA4 (for marketing analytics) and
 *  /api/track → Cloudflare D1 (for the operator's own dashboard at /admin/stats). */
const send = (name: string, params: Record<string, unknown> = {}) => {
  if (typeof gtag === 'function') gtag('event', name, params);

  // Best-effort POST. Errors and slow networks must not block UX.
  try {
    const payload = {
      type:   name,
      source: typeof params.source === 'string' ? params.source : undefined,
      lang:   typeof params.page_lang === 'string' ? params.page_lang : (document.documentElement.lang || 'uk').slice(0, 2),
      path:   location.pathname,
      ref:    document.referrer ? document.referrer.slice(0, 200) : undefined,
    };
    const body = JSON.stringify(payload);
    // sendBeacon survives page unload (critical for redirect-to-Monobank case).
    if (navigator.sendBeacon) {
      navigator.sendBeacon('/api/track', new Blob([body], { type: 'application/json' }));
    } else {
      fetch('/api/track', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body, keepalive: true }).catch(() => {});
    }
  } catch { /* swallow */ }
};

document.querySelectorAll<HTMLAnchorElement>('[data-buy-source]').forEach(a => {
  a.addEventListener('click', async (e) => {
    const source   = a.dataset.buySource || 'unknown';
    const pageLang = (document.documentElement.lang || 'uk').slice(0, 2);

    // Always fire the GA "click_buy" event.
    send('click_buy', { source, page_lang: pageLang });

    // Pre-launch: don't open checkout. Scroll to the e-mail capture and focus it.
    if ((window as any).TR_PRESALE) {
      e.preventDefault();
      const notify = document.getElementById('notify');
      const input  = document.getElementById('notify-email') as HTMLInputElement | null;
      if (notify) notify.scrollIntoView({ behavior: 'smooth', block: 'center' });
      if (input) setTimeout(() => input.focus(), 500);
      return;
    }

    // Only buttons flagged with data-checkout-trigger="1" open checkout.
    // (Footer / non-CTA links pass through normally.)
    if (a.dataset.checkoutTrigger !== '1') return;

    const lsUrl = (window as any).TR_LS_CHECKOUT as string;
    if (!lsUrl) return; // no payment provider wired — fall through to #price scroll

    // Open the PDF-language modal instead of redirecting straight to LS. Buyer
    // picks a language → we append ?checkout[custom][lang]=… → LS forwards it
    // to our webhook as meta.custom_data.lang → we sign the download token
    // for that language.
    e.preventDefault();
    const modal = document.getElementById('pdf-lang-modal');
    if (!modal) {
      // fallback: no modal in DOM — use page language
      const validLang = ['uk','ru','en','pl'].includes(pageLang) ? pageLang : 'en';
      const sep = lsUrl.includes('?') ? '&' : '?';
      window.location.href = lsUrl + sep +
        'checkout[custom][lang]='   + encodeURIComponent(validLang) +
        '&checkout[custom][source]=' + encodeURIComponent(source);
      return;
    }
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.documentElement.style.overflow = 'hidden';
    // stash the buyer's page-language so the modal handler can pick the
    // right store URL (no need to read documentElement.lang twice)
    modal.dataset.siteLang = pageLang;
    // Also stash which CTA the buyer clicked (hero / price / sticky-mobile / …)
    // so the modal handler can pass it to LS as ?checkout[custom][source]=<x>.
    // The webhook then forwards it to GA purchase's traffic_source_button so
    // we can slice conversions per button.
    modal.dataset.buySource = source;
  });
});

// PDF-language modal: close on backdrop / X, redirect on option click.
const pdfModal = document.getElementById('pdf-lang-modal');
if (pdfModal) {
  const closeModal = () => {
    pdfModal.classList.add('hidden');
    pdfModal.classList.remove('flex');
    document.documentElement.style.overflow = '';
  };
  pdfModal.addEventListener('click', (e) => { if (e.target === pdfModal) closeModal(); });
  document.getElementById('pdf-lang-close')?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !pdfModal.classList.contains('hidden')) closeModal();
  });
  pdfModal.querySelectorAll<HTMLButtonElement>('.pdf-lang-opt').forEach(btn => {
    btn.addEventListener('click', () => {
      const chosen = btn.dataset.pdfLang || 'uk';
      // Store URL is chosen by the SITE language the buyer clicked from
      // (uk site → UAH store, ru site → USD store, pl → PLN, en/de/… → EUR).
      // The PDF language they picked is independent and travels as custom_data.
      const pageLang = (document.documentElement.lang || 'uk').slice(0, 2);
      const byLang   = ((window as any).TR_LS_BY_LANG || {}) as Record<string, string>;
      const lsUrl    = byLang[pageLang] || (window as any).TR_LS_CHECKOUT as string;
      if (!lsUrl) { closeModal(); return; }
      send('pdf_lang_pick', { lang: chosen, site_lang: pageLang });
      const src = pdfModal?.dataset.buySource || 'unknown';
      const sep = lsUrl.includes('?') ? '&' : '?';
      window.location.href = lsUrl + sep +
        'checkout[custom][lang]='   + encodeURIComponent(chosen) +
        '&checkout[custom][source]=' + encodeURIComponent(src);
    });
  });
}

document.querySelectorAll<HTMLAnchorElement>('.lang-btn').forEach(a => {
  a.addEventListener('click', () => {
    send('language_switch', {
      target_lang: a.getAttribute('href') || '',
      from_lang: document.documentElement.lang || 'uk',
    });
  });
});

// ── Pre-launch waitlist form ──
const notifyForm = document.getElementById('notify-form') as HTMLFormElement | null;
if (notifyForm) {
  const input  = document.getElementById('notify-email') as HTMLInputElement;
  const submit = document.getElementById('notify-submit') as HTMLButtonElement;
  const msg    = document.getElementById('notify-msg') as HTMLElement;
  const showMsg = (text: string, ok: boolean) => {
    msg.textContent = text;
    msg.style.color = ok ? '#9FD3A8' : '#E5A8A8';
    msg.classList.remove('hidden');
  };
  notifyForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (input.value || '').trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      showMsg((window as any).TR_NOTIFY_ERR || 'Invalid email', false);
      input.focus();
      return;
    }
    const turnstileToken = (notifyForm.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement | null)?.value || '';
    if ((window as any).TR_TURNSTILE && !turnstileToken) {
      showMsg((window as any).TR_NOTIFY_ERR || 'Please wait a moment and try again', false);
      return;
    }
    submit.disabled = true;
    submit.style.opacity = '0.7';
    try {
      const res = await fetch('/api/waitlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, lang: (window as any).TR_PAGE_LANG || 'uk', source: 'homepage_notify', turnstileToken }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error('failed');
      showMsg((window as any).TR_NOTIFY_OK || 'Done!', true);
      notifyForm.reset();
      send('waitlist_signup', { page_lang: (window as any).TR_PAGE_LANG || 'uk' });
    } catch {
      showMsg((window as any).TR_NOTIFY_ERR || 'Try again', false);
    } finally {
      submit.disabled = false;
      submit.style.opacity = '1';
    }
  });
}

// FAQ open tracking — fire when a closed item becomes open
document.querySelectorAll<HTMLElement>('.faq-item').forEach(item => {
  item.addEventListener('click', () => {
    if (item.classList.contains('open')) {
      send('faq_open', {
        index: item.dataset.index || '',
        page_lang: document.documentElement.lang || 'uk',
      });
    }
  });
});

// Social block: profile pills + card clicks
document.querySelectorAll<HTMLAnchorElement>('[data-analytics^="social_"]').forEach(a => {
  a.addEventListener('click', () => {
    const eventName = a.dataset.analytics + '_' + (a.dataset.platform || 'unknown');
    send(eventName, {
      platform: a.dataset.platform,
      url: a.getAttribute('href') || '',
      location: a.dataset.location || 'unknown',
      page_lang: document.documentElement.lang || 'uk',
    });
  });
});

// One pageview per session per language. Use sessionStorage so refreshes within
// the same tab don't double-count, but each new tab/visit is a fresh hit.
(() => {
  try {
    const pageLang = (document.documentElement.lang || 'uk').slice(0, 2);
    const key = 'tbb_pv_' + pageLang + '_' + location.pathname;
    if (sessionStorage.getItem(key)) return;
    sessionStorage.setItem(key, '1');
    send('pageview', { page_lang: pageLang });
  } catch { /* swallow */ }
})();
</script>
