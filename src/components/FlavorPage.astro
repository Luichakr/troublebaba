---
import { Icon } from 'astro-icon/components';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { FLAVORS, FLAVOR_BY_SLUG, RECIPES_HUB, INGREDIENTS_BY_SLUG, INGREDIENTS_COPY } from '../data/flavors.js';
import { FLAVOR_META, DIFFICULTY_LABEL, TIME_LABEL, SECTIONS, getExtra } from '../data/flavors-extra.js';
import { t } from '../i18n/translations.js';
import { SITE } from '../config/site.js';

type Lang = 'uk' | 'ru' | 'pl' | 'en' | 'es' | 'de' | 'fr' | 'it' | 'pt';
interface Props { lang: Lang; slug: string; homeUrl: string; recipesUrl: string }
const { lang, slug, homeUrl, recipesUrl } = Astro.props;
const tr = (t as any)[lang] ?? (t as any).en;

const flavor = (FLAVOR_BY_SLUG as any)[slug];
const f = flavor.t[lang] ?? flavor.t.en;

// Ingredient names + "what's in the PDF" copy. Only uk+ru have curated data
// for now (other locales silently skip the section).
const ingSet = (INGREDIENTS_BY_SLUG as any)[slug] || {};
const ingredients: string[] | undefined = ingSet[lang];
const ingCopy = (INGREDIENTS_COPY as any)[lang];
const hub = (RECIPES_HUB as any)[lang] ?? (RECIPES_HUB as any).en;

// Other flavors for internal linking (exclude current).
const others = (FLAVORS as any[]).filter(x => x.slug !== slug);
const langPrefix = lang === 'uk' ? '' : '/' + lang;
const flavorUrl = (s: string) => `${langPrefix}/recipes/${s}/`;

// Bundle-only pricing card (single-recipe sale removed by owner ask —
// we only sell the full 10-recipe collection). Localized per lang.
const BUNDLE_CARD: Record<string, { title: string; hint: string; price: string }> = {
  uk: { title: 'Весь збірник · 10 рецептів', hint: 'Один платіж — усі 10 рецептів у PDF назавжди.', price: '800 ₴' },
  ru: { title: 'Весь сборник · 10 рецептов', hint: 'Один платёж — все 10 рецептов в PDF навсегда.', price: '$20' },
  pl: { title: 'Cały zbiór · 10 przepisów',  hint: 'Jedna płatność — wszystkie 10 przepisów w PDF na zawsze.', price: '80 zł' },
  en: { title: 'Full bundle · 10 recipes',   hint: 'One payment — all 10 recipes in PDF, yours forever.', price: '€18' },
  es: { title: 'Colección completa · 10 recetas', hint: 'Un solo pago — las 10 recetas en PDF, para siempre.', price: '€18' },
  de: { title: 'Komplette Sammlung · 10 Rezepte', hint: 'Eine Zahlung — alle 10 Rezepte als PDF, für immer.', price: '€18' },
  fr: { title: 'Recueil complet · 10 recettes',   hint: 'Un seul paiement — les 10 recettes en PDF, pour toujours.', price: '€18' },
  it: { title: 'Raccolta completa · 10 ricette',  hint: 'Un unico pagamento — tutte le 10 ricette in PDF, per sempre.', price: '€18' },
  pt: { title: 'Coleção completa · 10 receitas',  hint: 'Um único pagamento — as 10 receitas em PDF, para sempre.', price: '€18' },
};
const B = BUNDLE_CARD[lang] ?? BUNDLE_CARD.en;

// Enrichment: difficulty badge + time + occasion + common mistakes + FAQ.
// Текст есть на всех девяти языках (flavors-extra.<lang>.js), поэтому
// язык больше не сводится к четырём. Раньше здесь стояло сужение до
// uk/ru/pl/en, и es/de/fr/it/pt получали английские FAQ, ошибки и
// подписи секций при остальной странице на своём языке. Фолбэк на en
// оставлен как страховка: если он сработает — это баг в данных.
const meta = (FLAVOR_META as any)[slug];
const extraLang = ((SECTIONS as any)[lang] ? lang : 'en') as Lang;
const extra = getExtra(slug, extraLang);
const sec = (SECTIONS as any)[extraLang];
const difficultyLabel = meta && (DIFFICULTY_LABEL as any)[extraLang][meta.difficulty];
const timeLabel       = meta && (TIME_LABEL as any)[extraLang][meta.timeBucket];

// Curated internal linking to related flavors — 3 hand-picked siblings.
const relatedFlavors = (extra?.related || [])
  .map((s: string) => (FLAVOR_BY_SLUG as any)[s])
  .filter(Boolean);

// FAQ JSON-LD — Google shows a rich "People also ask"-style block for pages
// that expose FAQPage schema, so it earns a bigger SERP footprint.
const faqJsonLd = extra?.faq?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": extra.faq.map((qa: any) => ({
        "@type": "Question",
        "name": qa.q,
        "acceptedAnswer": { "@type": "Answer", "text": qa.a },
      })),
    }
  : null;
---
<SiteHeader lang={lang} />
<main class="min-h-[100dvh] pt-[68px] lg:pt-[72px]" style="background:#F5EFE8;">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-16 py-12 lg:py-20">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 font-outfit text-[13px] text-espresso/65 mb-10" aria-label="breadcrumb">
      <a href={homeUrl} class="hover:text-mocha transition-colors">TROUBLEBABA</a>
      <span aria-hidden="true">/</span>
      <a href={recipesUrl} class="hover:text-mocha transition-colors">{hub.allLabel}</a>
      <span aria-hidden="true">/</span>
      <span class="text-espresso/70">{f.name}</span>
    </nav>

    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">

      <!-- Image -->
      <div class="relative rounded-3xl overflow-hidden" style="aspect-ratio:4/5; box-shadow:0 24px 64px rgba(139,115,85,0.20);">
        <div class="img-skeleton absolute inset-0 w-full h-full"></div>
        <img src={flavor.image} alt={`${f.name} — ${f.layers}`} width="1122" height="1402"
             loading="eager" fetchpriority="high" decoding="async"
             class="absolute inset-0 w-full h-full object-cover"
             onload="this.previousElementSibling.style.display='none'" onerror="this.style.display='none'" />
        {flavor.bestseller && (
          <span class="absolute top-4 left-4 bg-mocha-dark text-warm-white font-outfit font-semibold text-[11px] tracking-[0.12em] uppercase px-3 py-1.5 rounded-full">★ Bestseller</span>
        )}
      </div>

      <!-- Content -->
      <div>
        <h1 class="font-cabinet text-espresso mb-3" style="font-size:var(--h-page);line-height:1.04;">{(f.metaTitle || f.name).split(' | ')[0]}</h1>
        <p class="font-outfit text-mocha text-[15px] tracking-wide mb-6">{f.layers}</p>
        <p class="font-outfit text-espresso/65 text-base leading-relaxed mb-8">{f.lead}</p>

        <!-- What you'll learn in the PDF -->
        <div class="bg-warm-white rounded-2xl p-6 mb-8" style="box-shadow:0 4px 18px rgba(139,115,85,0.10);">
          <div class="font-outfit text-[11px] font-bold uppercase tracking-[0.16em] text-mocha mb-4">{tr.flavor_pdf_heading}</div>
          <ul class="space-y-3">
            {f.learn.map((item: string) => (
              <li class="flex items-start gap-3 font-outfit text-espresso/75 text-[15px]">
                <Icon name="ph:check-circle" class="flex-shrink-0 mt-0.5 w-[18px] h-[18px]" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Ingredients (names only) + explicit note about what's in the paid PDF -->
        {ingredients && ingCopy && (
          <div class="bg-warm-white rounded-2xl p-6 mb-6" style="box-shadow:0 4px 18px rgba(139,115,85,0.10);">
            <div class="font-outfit text-[11px] font-bold uppercase tracking-[0.16em] text-mocha mb-2">{ingCopy.heading}</div>
            <p class="font-outfit text-espresso/65 text-[13px] leading-snug mb-4">{ingCopy.subline}</p>
            <div class="flex flex-wrap gap-2 mb-5">
              {ingredients.map((name) => (
                <span class="font-outfit text-espresso/80 text-[13px] bg-cream/80 border border-taupe/40 rounded-full px-3 py-1.5">
                  {name}
                </span>
              ))}
            </div>
            <p class="font-outfit text-espresso/70 text-[13.5px] leading-relaxed rounded-lg px-4 py-3.5" style="background:#FDFAF6;border:1px solid rgba(200,184,162,0.55);">
              {ingCopy.pdfNote}
            </p>
            <p class="font-outfit text-mocha font-semibold text-[13.5px] mt-4">{ingCopy.ctaHint}</p>
          </div>
        )}

        <!-- Bundle-only price card (we sell the full collection, no per-recipe sales) -->
        <div class="rounded-2xl overflow-hidden mb-6" style="border:1px solid rgba(200,184,162,0.4);">
          <div class="flex items-center justify-between gap-4 px-5 py-4 bg-espresso relative">
            <div>
              <div class="font-outfit font-bold text-warm-white text-[15px]">{B.title}</div>
              <div class="font-outfit text-warm-white/60 text-[13px] mt-0.5">{B.hint}</div>
            </div>
            <div class="text-right flex-shrink-0">
              <div class="font-outfit font-bold text-warm-white text-[24px] leading-none tracking-tight">{B.price}</div>
            </div>
          </div>
        </div>

        <a href={homeUrl + '#price'} class="inline-flex items-center justify-center gap-3 w-full sm:w-auto bg-mocha-dark text-warm-white font-outfit font-bold px-8 py-4 rounded-2xl hover:bg-mocha-dark transition-colors btn-pulse">
          {hub.cta}
          <Icon name="ph:arrow-right" class="w-[16px] h-[14px]" />
        </a>

        {meta && (difficultyLabel || timeLabel) && (
          <div class="flex flex-wrap gap-2 mt-6">
            {difficultyLabel && (
              <span class="inline-flex items-center gap-2 bg-warm-white border border-taupe/40 rounded-full px-3.5 py-2 font-outfit text-[13px] text-espresso/75">
                <Icon name="ph:chart-line-up" class="w-[14px] h-[14px]" />
                <span class="font-medium">{sec.difficulty}:</span>
                <span>{difficultyLabel}</span>
              </span>
            )}
            {timeLabel && (
              <span class="inline-flex items-center gap-2 bg-warm-white border border-taupe/40 rounded-full px-3.5 py-2 font-outfit text-[13px] text-espresso/75">
                <Icon name="ph:clock" class="w-[14px] h-[14px]" />
                <span class="font-medium">{sec.time}:</span>
                <span>{timeLabel}</span>
              </span>
            )}
          </div>
        )}
      </div>
    </div>

    {extra && (extra.occasion || extra.mistakes?.length) && (
      <section class="mt-24 lg:mt-32 grid lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] gap-12 lg:gap-20 items-start">
        {extra.occasion && (
          <figure class="relative pl-6 lg:pl-8">
            <span aria-hidden="true" class="absolute left-0 top-2 bottom-2 w-[3px] rounded-full bg-mocha/45"></span>
            <div class="font-outfit text-[11px] font-bold uppercase tracking-[0.22em] text-mocha mb-4">{sec.occasion}</div>
            <blockquote class="font-cabinet text-espresso" style="font-size:clamp(1.7rem,2.4vw,2.2rem);line-height:1.18;letter-spacing:-0.01em;">
              {extra.occasion}
            </blockquote>
          </figure>
        )}

        {extra.mistakes?.length && (
          <div>
            <div class="font-outfit text-[11px] font-bold uppercase tracking-[0.22em] text-mocha mb-5">{sec.mistakes}</div>
            <ol class="divide-y divide-taupe/30 border-y border-taupe/30">
              {extra.mistakes.map((m: string, i: number) => (
                <li class="flex items-start gap-4 py-4">
                  <span class="font-cabinet font-black text-mocha text-lg leading-none pt-0.5 tabular-nums flex-shrink-0" style="font-feature-settings:'tnum';">{String(i + 1).padStart(2, '0')}</span>
                  <span class="font-outfit text-espresso/80 text-[15px] leading-relaxed">{m}</span>
                </li>
              ))}
            </ol>
            <p class="font-outfit text-[13.5px] text-espresso/65 leading-relaxed mt-5">{sec.mistakesHelp}</p>
          </div>
        )}
      </section>
    )}

    {extra?.faq?.length && (
      <section class="mt-24 lg:mt-32 faq-section">
        <div class="grid lg:grid-cols-[minmax(0,340px)_minmax(0,1fr)] gap-10 lg:gap-16 xl:gap-24 items-start">

          <div class="lg:sticky lg:top-[92px]">
            <div class="font-outfit text-[11px] font-bold uppercase tracking-[0.22em] text-mocha mb-4">FAQ</div>
            <h2 class="font-cabinet text-espresso mb-5" style="font-size:clamp(2rem,3.4vw,2.75rem);line-height:1.05;letter-spacing:-0.01em;">{sec.faq}</h2>
            <p class="font-outfit text-espresso/65 text-[15px] leading-relaxed max-w-[36ch] mb-8">{sec.mistakesHelp}</p>
            <a href={homeUrl + '#price'} class="cta-pdf inline-flex items-center gap-3 bg-mocha-dark text-warm-white font-outfit font-semibold text-[15px] px-6 py-3.5 rounded-full transition-[background-color,transform] duration-150 ease-out hover:bg-mocha-dark active:scale-[0.97]">
              <span>{sec.pdfCta}</span>
              <Icon name="ph:arrow-right" class="cta-pdf-arrow transition-transform duration-200 ease-out w-[16px] h-[14px]" />
            </a>
          </div>

          <div class="border-t border-taupe/40">
            {extra.faq.map((qa: any, i: number) => (
              <details class="faq-item border-b border-taupe/40" open={i === 0}>
                <summary class="flex items-start justify-between gap-6 py-6 cursor-pointer list-none group">
                  <span class="font-cabinet text-espresso text-[19px] lg:text-[20px] leading-snug tracking-tight group-hover:text-mocha transition-colors duration-150">{qa.q}</span>
                  <span class="faq-chevron flex-shrink-0 mt-1 relative w-5 h-5" aria-hidden="true">
                    <span class="absolute inset-x-0 top-1/2 h-[1.6px] bg-mocha rounded-full -translate-y-1/2"></span>
                    <span class="faq-chevron-v absolute inset-y-0 left-1/2 w-[1.6px] bg-mocha rounded-full -translate-x-1/2"></span>
                  </span>
                </summary>
                <div class="faq-answer overflow-hidden">
                  <p class="font-outfit text-espresso/70 text-[15.5px] lg:text-base leading-relaxed pb-6 pr-6 max-w-[68ch]">{qa.a}</p>
                </div>
              </details>
            ))}
          </div>

        </div>
      </section>
    )}

    {relatedFlavors.length > 0 && (
      <section class="mt-24 lg:mt-32">
        <h2 class="font-cabinet text-espresso mb-10" style="font-size:clamp(2rem,3.4vw,2.75rem);line-height:1.05;letter-spacing:-0.01em;">{sec.related}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 lg:gap-6">
          {relatedFlavors.map((o: any, i: number) => (
            <a href={flavorUrl(o.slug)} class={`related-card group block rounded-2xl overflow-hidden bg-warm-white transition-transform duration-300 ease-out hover:-translate-y-1 ${i === 0 ? 'md:row-span-1' : ''}`} style="box-shadow:0 12px 32px rgba(139,115,85,0.10);">
              <div class="relative overflow-hidden" style="aspect-ratio:4/3;">
                <div class="img-skeleton absolute inset-0"></div>
                <img src={o.image} alt={(o.t[lang] ?? o.t.en).name} width="1122" height="842" loading="lazy" decoding="async"
                     class="absolute inset-0 w-full h-full object-cover transition-transform duration-[600ms] ease-out group-hover:scale-[1.04]"
                     onload="this.previousElementSibling.style.display='none'" onerror="this.style.display='none'" />
              </div>
              <div class="px-5 pt-4 pb-5">
                <div class="flex items-center gap-2">
                  <span class="font-cabinet text-espresso text-[18px] tracking-tight group-hover:text-mocha transition-colors duration-150">{(o.t[lang] ?? o.t.en).name}</span>
                  <Icon name="ph:arrow-right" class="ml-auto opacity-40 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all duration-200 ease-out w-[14px] h-[12px]" />
                </div>
                <p class="font-outfit text-espresso/65 text-[13.5px] mt-1 leading-relaxed line-clamp-2">{(o.t[lang] ?? o.t.en).layers}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {faqJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    )}

    <!-- Other flavors — horizontal scroller so all 9 stay reachable -->
    <section class="mt-20">
      <h2 class="font-cabinet text-espresso text-2xl mb-8">{hub.allLabel}</h2>
      <div class="flex gap-3 lg:gap-4 overflow-x-auto pb-4 snap-x snap-mandatory scroll-smooth"
           style="scrollbar-width:thin;-webkit-overflow-scrolling:touch;">
        {others.map((o: any) => (
          <a href={flavorUrl(o.slug)} class="group block flex-shrink-0 snap-start w-[42vw] sm:w-[220px] lg:w-[200px]">
            <div class="relative rounded-xl overflow-hidden mb-2" style="aspect-ratio:4/5;">
              <img src={o.image} alt={(o.t[lang] ?? o.t.en).name} width="1122" height="1402" loading="lazy" decoding="async"
                   class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.style.display='none'" />
            </div>
            <div class="font-cabinet text-espresso text-[15px] group-hover:text-mocha transition-colors">{(o.t[lang] ?? o.t.en).name}</div>
          </a>
        ))}
      </div>
    </section>
  </div>
</main>

<SiteFooter lang={lang} />

<style>
  /* FAQ chevron: horizontal line + vertical line → collapses to horizontal on open. */
  .faq-item .faq-chevron-v {
    transition: transform 200ms cubic-bezier(0.32,0.72,0,1), opacity 160ms ease-out;
    transform-origin: center;
  }
  .faq-item[open] .faq-chevron-v {
    transform: translateX(-50%) rotate(90deg);
    opacity: 0;
  }
  /* Answer: reveal with a real height + opacity transition, not a snap. */
  .faq-item .faq-answer {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 260ms cubic-bezier(0.32,0.72,0,1), opacity 200ms ease-out;
  }
  .faq-item .faq-answer > * { min-height: 0; }
  .faq-item[open] .faq-answer {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:focus-visible {
    outline: 2px solid rgba(139,115,85,0.55);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* CTA button: arrow eases forward on hover — a small mechanical hint. */
  .cta-pdf:hover .cta-pdf-arrow { transform: translateX(3px); }

  /* Respect reduced motion — collapse transitions to instant swaps. */
  @media (prefers-reduced-motion: reduce) {
    .faq-item .faq-chevron-v,
    .faq-item .faq-answer,
    .cta-pdf-arrow,
    .related-card { transition: none !important; }
  }
</style>

