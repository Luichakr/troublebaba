---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { t } from '../i18n/translations.js';
import { SITE } from '../config/site.js';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';

type Lang = 'uk' | 'ru' | 'pl' | 'en' | 'es' | 'de' | 'fr' | 'it' | 'pt';
interface Props { lang: Lang; homeUrl: string }
const { lang, homeUrl } = Astro.props;
const tr = (t as any)[lang] as Record<string, any>;

const all = await getCollection('blog', (e: any) => e.data.lang === lang && e.data.draft === false);
all.sort((a: any, b: any) => (a.data.publishedAt < b.data.publishedAt ? 1 : -1));
const langPrefix = lang === 'uk' ? '' : '/' + lang;
const postUrl = (slug: string) => `${langPrefix}/blog/${slug}/`;

// Three near-identical wide cards (Instagram, TikTok, YouTube→/shorts) used to
// be copy-pasted. The `tiles` data-attr is read by the inline script below to
// paint thumbnails, so it must stay exactly as-is per platform.
const wideBlocks = [
  { href: SITE.instagramUrl, external: true, analytics: 'blog_platform_block', platform: 'instagram',
    badge: { style: 'background:linear-gradient(135deg,#f09433,#dc2743,#bc1888);', icon: 'simple-icons:instagram', iconClass: 'w-[13px] h-[13px]' },
    label: 'Instagram', title: tr.blog_ig_title, sub: tr.blog_ig_sub, cta: tr.blog_ig_cta, tiles: 'data-blog-instagram-tiles', mb: 'mb-4' },
  { href: SITE.tiktokUrl, external: true, analytics: 'blog_platform_block', platform: 'tiktok',
    badge: { style: 'background:#000;', icon: 'simple-icons:tiktok', iconClass: 'w-[11px] h-[13px]' },
    label: 'TikTok', title: tr.blog_tt_title, sub: tr.blog_tt_sub, cta: tr.blog_tt_cta, tiles: 'data-blog-tiktok-tiles', mb: 'mb-4' },
  { href: `${langPrefix}/shorts/`, external: false, analytics: 'blog_videos_promo_click', platform: 'shorts',
    badge: { dot: true },
    label: 'YouTube', title: tr.blog_videos_title, sub: tr.blog_videos_sub, cta: tr.blog_videos_cta, tiles: 'data-blog-videos-tiles', mb: 'mb-12' },
] as const;

// Small "follow" pills under the wide cards.
const socialPills = [
  { url: SITE.instagramUrl, platform: 'instagram', icon: 'simple-icons:instagram', iconClass: 'w-[16px] h-[16px]', label: tr.social_pill_ig },
  { url: SITE.tiktokUrl,    platform: 'tiktok',    icon: 'simple-icons:tiktok',    iconClass: 'w-[14px] h-[16px]', label: tr.social_pill_tt },
  { url: SITE.youtubeUrl,   platform: 'youtube',   icon: 'simple-icons:youtube',   iconClass: 'w-[18px] h-[13px]', label: tr.social_pill_yt },
] as const;
---
<SiteHeader lang={lang} />
<main class="min-h-[100dvh] pt-[68px] lg:pt-[72px]" style="background:var(--color-cream);">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-16 py-12 lg:py-20">

    <a href={homeUrl} class="inline-flex items-center gap-2 font-outfit text-mocha-dark hover:text-mocha-dark transition-colors text-sm mb-10">
      <Icon name="ph:arrow-left" aria-hidden="true" class="w-[14px] h-[12px]" />
      <span>{tr.blog_back}</span>
    </a>

    <header class="max-w-[980px] mb-10">
      <h1 class="font-cabinet text-espresso mb-5" style="font-size:var(--h-section);line-height:1.02;">{tr.blog_heading}</h1>
      <p class="font-outfit text-espresso/65 text-base leading-relaxed">{tr.blog_intro}</p>
    </header>

    {/* Three wide platform cards (Instagram, TikTok, YouTube→/shorts). */}
    {wideBlocks.map(block => (
      <a href={block.href}
         target={block.external ? '_blank' : undefined} rel={block.external ? 'noopener noreferrer' : undefined}
         data-analytics={block.analytics} data-platform={block.platform}
         class:list={['group block rounded-2xl bg-warm-white overflow-hidden hover:-translate-y-0.5 transition-transform duration-300', block.mb]}
         style="box-shadow:0 8px 32px rgba(139,115,85,0.10), 0 24px 64px rgba(139,115,85,0.06); border:1px solid rgba(200,184,162,0.30);">
        <div class="grid sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] items-stretch">
          <div class="px-6 sm:px-8 lg:px-10 py-6 lg:py-7 flex flex-col justify-center">
            <div class="flex items-center gap-3 mb-3">
              {'dot' in block.badge
                ? <span class="inline-block w-2 h-2 rounded-full" style="background:#B85959; box-shadow:0 0 0 4px rgba(184,89,89,0.18);"></span>
                : <span class="text-white w-6 h-6 rounded-md flex items-center justify-center" style={block.badge.style}><Icon name={block.badge.icon} class={block.badge.iconClass} /></span>}
              <span class="font-outfit text-[11px] font-bold uppercase tracking-[0.22em] text-mocha-dark">{block.label}</span>
            </div>
            <h2 class="font-cabinet text-espresso mb-3 group-hover:text-mocha-dark transition-colors" style="font-size:clamp(1.2rem,1.9vw,1.5rem);line-height:1.12;">{block.title}</h2>
            <p class="font-outfit text-espresso/65 text-[13.5px] leading-relaxed mb-3.5 max-w-[420px]">{block.sub}</p>
            <span class="inline-flex items-center gap-2 font-outfit text-mocha-dark font-semibold text-sm">
              <span>{block.cta}</span>
              <Icon name="ph:arrow-right" aria-hidden="true" class="w-[14px] h-[12px]" />
            </span>
          </div>
          <div class="px-6 sm:px-8 lg:pr-10 pb-6 pt-2 sm:pl-0 sm:py-6 lg:py-7">
            <div class="grid grid-cols-4 gap-2.5" {...{ [block.tiles]: '' }}>
              {Array.from({length: 4}).map(() => (
                <div class="rounded-md bg-espresso/5" style="aspect-ratio:9/16;"></div>
              ))}
            </div>
          </div>
        </div>
      </a>
    ))}

    {/* Follow on social — blog → social funnel */}
    <div class="flex flex-wrap items-center gap-3 mb-12">
      <span class="font-outfit text-espresso/65 text-sm font-medium mr-1">{tr.blog_social_follow}</span>
      {socialPills.map(pill => (
        <a href={pill.url} target="_blank" rel="noopener noreferrer"
           data-analytics="blog_social_click" data-platform={pill.platform}
           class="inline-flex items-center gap-2 bg-warm-white border border-taupe/30 hover:border-mocha/50 transition-colors rounded-full px-4 py-2.5 text-espresso/75 font-outfit text-sm font-medium min-h-[44px]">
          <Icon name={pill.icon} aria-hidden="true" class={pill.iconClass} />
          <span>{pill.label}</span>
        </a>
      ))}
    </div>

    <script is:inline>
      (function () {
        function esc(s) { return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

        // Render 4 tiles from an API URL into a target grid.
        function paint(targetSel, apiUrl) {
          const tiles = document.querySelector(targetSel);
          if (!tiles) return;
          fetch(apiUrl).then(function (r) { return r.ok ? r.json() : null; }).then(function (data) {
            if (!data || !data.ok) return;
            const items = [];
            if (data.current) items.push(data.current);
            (data.recent || []).forEach(function (s) { items.push(s); });
            if (!items.length) return;
            tiles.innerHTML = items.slice(0, 4).map(function (s) {
              const isYt = (s.platform === 'youtube' || !s.platform) && s.videoId;
              const raw = isYt
                ? 'https://i.ytimg.com/vi/' + esc(s.videoId) + '/hqdefault.jpg'
                : (s.thumbnail || '');
              // Route social CDN images through our proxy so IG/TT hotlink
              // protection can't block them; YouTube thumbnails serve fine
              // directly and skip the proxy. Images we host ourselves (paths
              // starting with /) must skip it too — Instagram's signed CDN URLs
              // expire and can't be refreshed from our server, so those tiles
              // are served from copies stored under /images/social/.
              const isLocal = raw.charAt(0) === '/';
              const thumb = raw && !isYt && !isLocal
                ? '/api/thumb?src=' + encodeURIComponent(raw)
                : raw;
              const inner = thumb
                ? '<img src="' + esc(thumb) + '" alt="' + esc(s.title) + '" width="200" height="356" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="absolute inset-0 w-full h-full object-cover" onerror="this.style.display=\'none\'"/>'
                : '<span class="absolute inset-0 flex items-center justify-center" style="background:linear-gradient(135deg,var(--color-taupe),var(--color-mocha));"></span>';
              return '<a href="' + esc(s.url) + '" target="_blank" rel="noopener noreferrer"' +
                ' class="relative block rounded-md overflow-hidden bg-espresso/5 hover:-translate-y-0.5 transition-transform duration-300"' +
                ' style="aspect-ratio:9/16;" title="' + esc(s.title) + '">' +
                inner +
                '<span class="absolute inset-0 bg-gradient-to-t from-espresso/45 via-espresso/0 to-transparent"></span>' +
                '</a>';
            }).join('');
          }).catch(function () {});
        }

        paint('[data-blog-videos-tiles]',   '/api/shorts/feed?all=1&limit=8');
        paint('[data-blog-instagram-tiles]', '/api/shorts/feed?platform=instagram&limit=8');
        paint('[data-blog-tiktok-tiles]',    '/api/shorts/feed?platform=tiktok&limit=8');
      })();
    </script>

    <!-- All articles. The social strip sits above as a compact teaser; the
         posts themselves used to carry a `hidden` class here and were invisible. -->
    {all.length === 0 ? (
      <p class="font-outfit text-espresso/65 italic py-10">{tr.blog_empty}</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {all.map((post: any) => (
          <a href={postUrl(post.data.slug)} class="group block bg-warm-white rounded-2xl overflow-hidden" style="box-shadow:0 4px 18px rgba(139,115,85,0.10);">
            {post.data.cover && (
              <div class="relative overflow-hidden" style="aspect-ratio:16/10;">
                <img src={post.data.cover} alt={post.data.title} loading="lazy" decoding="async" class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-500" onerror="this.style.display='none'" />
              </div>
            )}
            <div class="p-5">
              <h2 class="font-cabinet text-espresso text-lg mb-2 leading-snug group-hover:text-mocha-dark transition-colors">{post.data.title}</h2>
              <p class="font-outfit text-espresso/65 text-[13px] leading-relaxed">{post.data.excerpt ?? post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</main>
<SiteFooter lang={lang} />
