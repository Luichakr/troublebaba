---
// Fixed top bar with logo, nav, language dropdown, buy CTA and mobile burger.
// Originally lived inline in HomePage.astro; extracted so /recipes/[slug],
// /about, /contact, /blog/[slug], /privacy, /terms etc. get the same header
// (buyers were landing on flavor pages with no way back to the store).
//
// The `href` for CTA and anchor links resolves to the language home, so on
// pages that AREN'T the landing (like /recipes/oreo/) clicking "Купити" or
// "FAQ" sends the visitor to /#price / /#faq, which is what buyers expect.

import { t } from '../i18n/translations.js';

type Lang = 'uk' | 'ru' | 'pl' | 'en' | 'es' | 'de' | 'fr' | 'it' | 'pt';
interface Props { lang: Lang }
const { lang } = Astro.props;
const tr = (t as any)[lang] as Record<string, any>;
const isUk = lang === 'uk';
// Preserve the current path when switching language. E.g. on
// /ru/recipes/red-velvet-bento-cake/ switching to en → /en/recipes/red-velvet-bento-cake/.
// Falls back to home when no path is available.
const SUPPORTED = new Set(['uk','ru','pl','en','es','de','fr','it','pt']);
const rawPath   = (Astro.url && Astro.url.pathname) || '/';
const _parts    = rawPath.replace(/^\/+/, '').replace(/\/+$/, '').split('/');
const _headIsLang = _parts.length > 0 && SUPPORTED.has(_parts[0]);
const subPath   = _headIsLang ? _parts.slice(1).join('/') : _parts.join('/');
const langUrl  = (l) => {
  const base = l === 'uk' ? '/' : `/${l}/`;
  return subPath ? base + subPath + '/' : base;
};
const blogHref = isUk ? '/blog/' : `/${lang}/blog/`;
const anchor   = (id: string) => (isUk ? '/' : `/${lang}/`) + '#' + id;

const LANGS: { c: Lang; l: string; full: string }[] = [
  { c: 'uk', l: 'UKR', full: 'Українська' },
  { c: 'ru', l: 'RUS', full: 'Русский' },
  { c: 'en', l: 'ENG', full: 'English' },
  { c: 'pl', l: 'POL', full: 'Polski' },
  { c: 'es', l: 'ESP', full: 'Español' },
  { c: 'de', l: 'DEU', full: 'Deutsch' },
  { c: 'fr', l: 'FRA', full: 'Français' },
  { c: 'it', l: 'ITA', full: 'Italiano' },
  { c: 'pt', l: 'POR', full: 'Português' },
];
const currentLangLabel = LANGS.find(x => x.c === lang)?.l ?? 'UKR';
---
<header class="fixed top-0 left-0 right-0 z-50 bg-cream/95 backdrop-blur-md border-b border-taupe/15">
  <div class="max-w-[1440px] mx-auto px-4 lg:px-16 h-[68px] lg:h-[72px] flex items-center justify-between gap-2 lg:gap-6">
    <a href={langUrl(lang)} class="font-cabinet text-espresso flex-shrink-0 text-[1.1rem] lg:text-[1.55rem]" style="letter-spacing:0.01em;">TROUBLEBABA</a>
    <nav class="hidden md:flex items-center gap-10 font-outfit text-[12px] font-semibold tracking-[0.16em] uppercase text-espresso/65">
      <a href={anchor('recipes')} class="hover:text-espresso transition-colors">{tr.nav_recipes}</a>
      <a href={anchor('about')}   class="hover:text-espresso transition-colors">{tr.nav_author}</a>
      <a href={blogHref}          class="hover:text-espresso transition-colors">{['uk','ru'].includes(lang) ? 'Блог' : 'Blog'}</a>
      <a href={anchor('price')}   class="hover:text-espresso transition-colors">{tr.nav_price}</a>
      <a href={anchor('faq')}     class="hover:text-espresso transition-colors">FAQ</a>
    </nav>
    <div class="flex items-center gap-3 flex-shrink-0">
      <div class="relative hidden sm:block" id="lang-dropdown-wrap">
        <button id="lang-dropdown-btn" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="lang-menu" aria-label="Choose language" class="flex items-center gap-1.5 font-outfit font-semibold text-[12px] tracking-[0.12em] uppercase text-espresso/70 hover:text-espresso transition-colors px-4 py-2.5 rounded-full border border-taupe/40 hover:border-taupe/60">
          <span id="lang-label">{currentLangLabel}</span>
          <svg width="11" height="7" viewBox="0 0 12 8" fill="none" class="transition-transform duration-200" id="lang-chevron">
            <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div id="lang-menu" role="listbox" aria-label="Languages" class="hidden absolute right-0 top-full mt-2 bg-warm-white border border-taupe/25 rounded-2xl shadow-xl overflow-hidden min-w-[150px] z-50" style="box-shadow:0 12px 40px rgba(139,115,85,0.18);">
          {LANGS.map(x => (
            <a href={langUrl(x.c)} role="option" aria-label={x.full} aria-current={x.c === lang ? 'page' : undefined} class={`lang-btn w-full flex items-center justify-between px-4 py-3 font-outfit text-sm transition-colors ${x.c === lang ? 'bg-surface text-espresso' : 'text-espresso/70 hover:bg-surface hover:text-espresso'}`}>
              <span class="font-medium">{x.full}</span>
              <span class="text-xs text-espresso/35 font-mono">{x.l}</span>
            </a>
          ))}
        </div>
      </div>
      <a href={isUk ? '/#price' : '/' + lang + '/#price'} data-checkout-trigger="1" data-buy-source="header"
         class="flex items-center gap-1.5 bg-mocha text-warm-white font-outfit font-semibold text-[11.5px] lg:text-[13px] px-3 lg:px-5 py-2 lg:py-2.5 rounded-full hover:bg-mocha-dark transition-colors whitespace-nowrap">
        {tr.nav_buy}
      </a>
      <button id="mobile-menu-btn" type="button" aria-controls="mobile-menu" aria-expanded="false" class="md:hidden w-9 h-9 rounded-full flex items-center justify-center text-espresso hover:bg-taupe/15 transition-colors flex-shrink-0" aria-label="Menu">
        <svg width="18" height="13" viewBox="0 0 20 14" fill="none">
          <path d="M1 1h18M1 7h18M1 13h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
  <div id="mobile-menu" role="menu" aria-label="Main menu" class="hidden md:hidden absolute top-full left-0 right-0 bg-warm-white border-b border-taupe/20" style="box-shadow:0 12px 32px rgba(139,115,85,0.15);">
    <div class="px-6 py-4 flex flex-col gap-1">
      <a href={anchor('recipes')} class="font-outfit font-semibold text-[13px] tracking-[0.14em] uppercase text-espresso/70 hover:text-espresso py-3 border-b border-taupe/10 transition-colors mobile-menu-link">{tr.nav_recipes}</a>
      <a href={anchor('about')}   class="font-outfit font-semibold text-[13px] tracking-[0.14em] uppercase text-espresso/70 hover:text-espresso py-3 border-b border-taupe/10 transition-colors mobile-menu-link">{tr.nav_author}</a>
      <a href={anchor('price')}   class="font-outfit font-semibold text-[13px] tracking-[0.14em] uppercase text-espresso/70 hover:text-espresso py-3 border-b border-taupe/10 transition-colors mobile-menu-link">{tr.nav_price}</a>
      <a href={anchor('faq')}     class="font-outfit font-semibold text-[13px] tracking-[0.14em] uppercase text-espresso/70 hover:text-espresso py-3 border-b border-taupe/10 last:border-b-0 transition-colors mobile-menu-link">FAQ</a>
      <div class="pt-3 mt-2 flex gap-2">
        {LANGS.map(x => (
          <a href={langUrl(x.c)} aria-current={x.c === lang ? 'page' : undefined} class={`lang-btn flex-1 text-center font-outfit font-semibold text-[11px] tracking-[0.12em] uppercase transition-colors py-2 rounded-full border ${x.c === lang ? 'bg-surface text-espresso border-taupe/60' : 'text-espresso/55 hover:text-espresso border-taupe/30'}`}>{x.l}</a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  const mobBtn = document.getElementById('mobile-menu-btn');
  const mobMenu = document.getElementById('mobile-menu');
  const setMob = (open: boolean) => { mobMenu?.classList.toggle('hidden', !open); mobBtn?.setAttribute('aria-expanded', String(open)); };
  if (mobBtn && mobMenu) {
    mobBtn.addEventListener('click', (e) => { e.stopPropagation(); setMob(mobMenu.classList.contains('hidden')); });
    document.querySelectorAll('.mobile-menu-link').forEach(a => a.addEventListener('click', () => setMob(false)));
    document.addEventListener('click', (e) => {
      if (!mobMenu.contains(e.target as Node) && !mobBtn.contains(e.target as Node)) setMob(false);
    });
  }
  const dropBtn = document.getElementById('lang-dropdown-btn');
  const dropMenu = document.getElementById('lang-menu');
  const dropChev = document.getElementById('lang-chevron');
  const setDrop = (open: boolean) => {
    dropMenu?.classList.toggle('hidden', !open);
    dropBtn?.setAttribute('aria-expanded', String(open));
    dropChev?.style.setProperty('transform', open ? 'rotate(180deg)' : '');
  };
  if (dropBtn && dropMenu) {
    dropBtn.addEventListener('click', (e) => { e.stopPropagation(); setDrop(dropMenu.classList.contains('hidden')); });
    document.addEventListener('click', () => setDrop(false));
  }
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { setMob(false); setDrop(false); } });
</script>
