---
import Layout from '../../layouts/Layout.astro';
import BlogHub from '../../components/BlogHub.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/translations.js';
import { SITE } from '../../config/site.js';
const lang = 'uk' as const;
const tr = (t as any)[lang];

const published = await getCollection('blog', (e: any) => e.data.draft === false && e.data.lang === lang);
const posts = published.sort((a: any, b: any) => (b.data.publishedAt ?? '').localeCompare(a.data.publishedAt ?? ''));

// ItemList of published articles — helps Google understand this is a hub
// page and can surface individual posts as a carousel under a brand query.
const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": tr.blog_meta_title,
  "itemListElement": posts.map((p: any, i: number) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": SITE.url + '/blog/' + p.data.slug + '/',
    "name": p.data.title,
  })),
};
---
<Layout title={tr.blog_meta_title} description={tr.blog_meta_desc} lang={lang} path="blog" pageType="content" jsonLd={itemListJsonLd}>
  <BlogHub lang={lang} homeUrl="/" />
</Layout>
