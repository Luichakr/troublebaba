---
import Layout from '../../layouts/Layout.astro';
import FlavorPage from '../../components/FlavorPage.astro';
import { FLAVORS, FLAVOR_BY_SLUG } from '../../data/flavors.js';
import { SITE } from '../../config/site.js';

export function getStaticPaths() {
  return (FLAVORS as any[]).map(f => ({ params: { slug: f.slug } }));
}
const lang = 'uk' as const;
const { slug } = Astro.params as { slug: string };
const flavor = (FLAVOR_BY_SLUG as any)[slug];
const f = flavor.t[lang];
const heroImage = SITE.url + '/' + flavor.image.replace(/^\/+/, '');

// РАЗМЕТКА: Product, а НЕ Recipe. Здесь стоял Recipe с комментарием
// «схеме нужна хотя бы заглушка, чтобы сниппет сработал» — и это была
// ставка, которая не выдерживает проверки.
//
// Тип Recipe заявляет Google: на странице лежит рецепт. А страница —
// сознательно тизер: она сама пишет «Показані лише базові продукти,
// точні грамажі — у PDF-збірнику», перечисляет продукты БЕЗ количеств
// и не даёт ни одного шага приготовления. recipeInstructions состоял
// из одного HowToStep, внутри которого была не инструкция, а реклама
// сборника.
//
// Google сверяет разметку с видимым содержимым. При таком расхождении
// расширенный результат в лучшем случае не выдаётся, в худшем — это
// spammy structured data, а это ручные меры на весь домен. Отдавать
// настоящий рецепт мы не будем (решение владельца), значит правдивым
// Recipe тут стать не может — и тип убран.
//
// Product правдив: страница действительно продаёт сборник по этой цене
// и с этой кнопкой. Это и даёт законный шанс на цену в выдаче.
// aggregateRating сюда НЕ добавляем: отзывы живут на главной, а Google
// просит размечать оценку только там, где она видна на странице.
const price = (SITE.pricesByLang as any)[lang] ?? (SITE.pricesByLang as any).uk;
const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": SITE.productName,
  "description": f.metaDesc,
  "image": [heroImage],
  "brand": { "@type": "Brand", "name": SITE.name },
  "sku": "troublebaba-bento-cake-pdf",
  "inLanguage": lang,
  "offers": {
    "@type": "Offer",
    "price": price.amount,
    "priceCurrency": price.currency,
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition",
    "url": SITE.url + `/recipes/${slug}/`,
    "seller": { "@type": "Organization", "name": SITE.name },
  },
};
---
<Layout
  title={f.metaTitle}
  description={f.metaDesc}
  lang={lang}
  path={`recipes/${slug}`}
  pageType="content"
  ogImage={flavor.image}
  jsonLd={productJsonLd}
  breadcrumb={{ name: 'Рецепти', url: '/recipes/' }}
>
  <FlavorPage lang={lang} slug={slug} homeUrl="/" recipesUrl="/recipes/" />
</Layout>
