---
import { getCollection } from 'astro:content';
import BlogArticle from '../../../components/BlogArticle.astro';

type Lang = 'ru' | 'pl' | 'en' | 'es' | 'de' | 'fr' | 'it' | 'pt';

export async function getStaticPaths() {
  const langs = ['ru', 'pl', 'en', 'es', 'de', 'fr', 'it', 'pt'] as const;
  const published = await getCollection('blog', (e: any) => e.data.draft === false);
  const nonUk = published.filter((e: any) => langs.includes(e.data.lang));
  return nonUk.map((post: any) => {
    // Related posts: same language, ranked by shared tags, then filled with
    // other same-language posts. Builds topic clusters + internal linking.
    const sameLang = nonUk.filter((p: any) => p.data.lang === post.data.lang && p.data.slug !== post.data.slug);
    const related = sameLang
      .map((p: any) => ({ p, shared: (p.data.tags || []).filter((tg: string) => (post.data.tags || []).includes(tg)).length }))
      .sort((a: any, b: any) => b.shared - a.shared)
      .slice(0, 3)
      .map((x: any) => ({ slug: x.p.data.slug, title: x.p.data.title }));
    return {
      params: { lang: post.data.lang, slug: post.data.slug },
      props: { post, slugLangs: published.filter((p: any) => p.data.slug === post.data.slug).map((p: any) => p.data.lang), related },
    };
  });
}

const { post, slugLangs, related } = Astro.props as { post: any; slugLangs: string[]; related: { slug: string; title: string }[] };
const { lang } = Astro.params as { lang: Lang };
---
<BlogArticle post={post} lang={lang} slugLangs={slugLangs} related={related} />
